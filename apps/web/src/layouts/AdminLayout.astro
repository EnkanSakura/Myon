---
/**
 * 后台壳：左侧固定栏 + 右侧主区。设计稿里每个后台页都重复了一遍侧栏，
 * 这里收成一份，用 `active` 控制高亮，用 `crumb` 控制面包屑末级。
 * 后台是暗色制作台，不带前台的深浅色切换，也不加载 site.js。
 */
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import type { SiteStats } from '@myon/shared';
import {
  apiBasePath,
  defaultSiteSettings,
  defaultThemeColor,
  formatPageTitle,
  toPublicSiteSettings,
} from '@myon/shared';
import ThemeTokens from '../components/ThemeTokens.astro';

interface Props {
  /** 页面名，例如「总览」；完整标题由布局拼成 `页面名 · 站点名 副标题`。 */
  title: string;
  crumb: string;
  active:
    | 'overview'
    | 'articles'
    | 'moments'
    | 'gallery'
    | 'bangumi'
    | 'tools'
    | 'media'
    | 'settings'
    | 'about';
}

const { title, crumb, active } = Astro.props;

const site = Astro.locals.site ?? toPublicSiteSettings(defaultSiteSettings);
const pageTitle = formatPageTitle(title, site);

// 主题色由后台配置；后台本身固定深墨底，只吃强调色。
const themeColor = site.themeColor || defaultThemeColor;

// 侧栏计数用真实数据：内容与媒体数量都来自 /api/v1/stats。
// 取不到时显示 0，不要回退设计稿数字。
const bindings = env as unknown as AppBindings;

/** 单个接口失败不该带崩整页：返回 null，计数降级成 0。 */
async function readApi<T>(path: string): Promise<T | null> {
  try {
    const response = await app.request(path, {}, bindings);
    if (!response.ok) return null;
    return (await response.json()) as T;
  } catch (error) {
    console.error(`读取 ${path} 失败`, error);
    return null;
  }
}

const stats = await readApi<SiteStats>(`${apiBasePath}/stats`);

const counts = {
  articles: stats?.posts.published ?? 0,
  moments: stats?.moments.total ?? 0,
  gallery: stats?.gallery.total ?? 0,
  bangumi: stats?.bangumi.total ?? 0,
  media: stats?.media.total ?? 0,
  tools: stats?.tools.total ?? 0,
};

// 顶栏不再挂假的部署哈希，改成当前运行环境标记。
const environment = String(env.ENVIRONMENT ?? 'unknown').toUpperCase();

// 管理令牌的入口只在这里：所有后台页共用同一个弹窗与连接状态。
// 状态检测只发一次读请求，页面本身仍然各自处理自己的 401 / 503。
const tokenCheckUrl = `${apiBasePath}/admin/settings`;
const maintenanceEnabled = Boolean(site.maintenanceEnabled);

const groups = [
  {
    label: '',
    items: [{ id: 'overview', href: '/admin', label: '总览', count: '08' }],
  },
  {
    label: '内容',
    items: [
      {
        id: 'articles',
        href: '/admin/articles',
        label: '文章',
        count: String(counts.articles),
      },
      {
        id: 'moments',
        href: '/admin/moments',
        label: '动态',
        count: String(counts.moments),
        countId: 'railNotes',
      },
      {
        id: 'gallery',
        href: '/admin/gallery',
        label: '展柜',
        count: String(counts.gallery),
        countId: 'railGallery',
      },
      {
        id: 'bangumi',
        href: '/admin/bangumi',
        label: '追番',
        count: String(counts.bangumi),
        countId: 'railBangumi',
      },
      {
        id: 'tools',
        href: '/admin/tools',
        label: '工具',
        count: String(counts.tools),
      },
    ],
  },
  {
    label: '资源',
    items: [
      // 媒体库计数被不同脚本用两种 id 引用（mediaCount / railMedia），
      // 这里把数字包一层内层节点，两个 id 都能取到。
      {
        id: 'media',
        href: '/admin/media',
        label: '媒体库',
        count: String(counts.media),
        countId: 'mediaCount',
        innerId: 'railMedia',
      },
    ],
  },
] as const;

const tail = [
  { id: 'settings', href: '/admin/settings', label: '设置' },
  { id: 'about', href: '/admin/about', label: '关于 / README' },
] as const;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/v2.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <ThemeTokens themeColor={themeColor} metaColor="#17131A" />
    <slot name="head" />
  </head>
  <body class="admin" data-token-check={tokenCheckUrl}>
    <aside class="side" aria-label="制作进行侧栏">
      <div class="side-head">
        <div class="s-brand"><b>MYON</b><span>制作进行</span></div>
        <div class="s-kick">PRODUCTION CONSOLE · 08</div>
      </div>

      <nav class="side-nav" aria-label="控制台导航">
        {
          groups.map((group) => (
            <>
              {group.label ? <div class="grp">{group.label}</div> : null}
              {group.items.map((item) => (
                <a
                  class:list={['s-item', { 'is-here': item.id === active }]}
                  href={item.href}
                  aria-current={item.id === active ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <span class="c" id={'countId' in item ? item.countId : undefined}>
                    {'innerId' in item ? <span id={item.innerId}>{item.count}</span> : item.count}
                  </span>
                </a>
              ))}
            </>
          ))
        }

        <div class="nav-tail">
          {
            tail.map((item) => (
              <a
                class:list={['s-item', { 'is-here': item.id === active }]}
                href={item.href}
                aria-current={item.id === active ? 'page' : undefined}
              >
                <span>{item.label}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <div class="side-foot">
        <div class="s-state" id="sideLamp" data-on={maintenanceEnabled ? 'false' : 'true'}>
          <i class="s-lamp" aria-hidden="true"></i>
          <span id="sideLampText">{maintenanceEnabled ? '维护中' : '营业中'}</span>
        </div>
        <a class="s-out" href="/">返回前台</a>
      </div>
    </aside>

    <main class="main">
      <header class="top">
        <div class="crumb">
          <i class="c-sq" aria-hidden="true"></i>
          <span>制作进行</span>
          <span aria-hidden="true">/</span>
          <span class="cur">{crumb}</span>
        </div>
        <div class="top-r">
          <a class="t-preview" href="/">预览前台 <span class="ar" aria-hidden="true">↗</span></a>
          <span class="t-div" aria-hidden="true"></span>
          <span class="deploy">运行环境 <b>{environment}</b></span>
          <button
            class="t-token"
            id="adminTokenOpen"
            type="button"
            data-token-open
            data-state="idle"
            aria-haspopup="dialog"
            aria-controls="adminTokenDlg"
          >
            <span class="t-token-lamp" id="adminTokenLamp" data-on="false" aria-hidden="true"></span>
            <span class="t-token-k">管理令牌</span>
            <b class="t-token-v" id="adminTokenState" aria-live="polite">未填写</b>
          </button>
          <span class="avatar" role="img" aria-label="登录账号 MY">MY</span>
        </div>
      </header>

      <slot />
    </main>

    <!-- ---------- 管理令牌：全后台唯一入口 ---------- -->
    <dialog class="dlg token-dlg" id="adminTokenDlg" aria-labelledby="adminTokenTitle">
      <form class="dlg-box" id="adminTokenForm" novalidate>
        <span class="dlg-tab">ADMIN / 令牌</span>
        <div class="dlg-h">
          <span id="adminTokenTitle">管理令牌</span>
          <span id="adminTokenDlgState">未填写</span>
        </div>
        <label class="token-label" for="adminTokenInput">令牌 / TOKEN</label>
        <input
          class="dlg-note token-input"
          id="adminTokenInput"
          type="password"
          placeholder="管理令牌"
          autocomplete="current-password"
          spellcheck="false"
        />
        <p class="dlg-c token-note">
          令牌只保存在这台浏览器，用来解锁后台的读写操作；清除后页面会回到未连接状态。
        </p>
        <div class="dlg-f">
          <span class="dlg-c" id="adminTokenMsg" role="status" aria-live="polite">未填写</span>
          <div class="dlg-a">
            <button class="p-btn" id="adminTokenClear" type="button">清除</button>
            <button class="p-btn p-btn--pub" id="adminTokenSave" type="submit">保存并刷新</button>
          </div>
        </div>
      </form>
    </dialog>

    <script is:inline src="/js/admin-token.js"></script>
  </body>
</html>
