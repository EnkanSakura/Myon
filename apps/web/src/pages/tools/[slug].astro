---
// 单个工具页：/tools/<slug>。工具列表与索引同源（GET /api/v1/tools，只含启用项）。
// 按 toolKey 渲染内置工作台（X 媒体下载 / LC 计算器 / 漫画下载）；未识别的 key 给「未配置」空态；
// 自定义链接工具在服务端 302 到后台登记的 href；找不到条目按 404 渲染空态。
// 样式：public/css/pages/tools.css；工作台脚本在页面底部按 toolKey 条件加载。
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import {
  apiBasePath,
  type ToolItem,
  type ToolListResponse,
} from '@myon/shared';
import SiteLayout from '../../layouts/SiteLayout.astro';

const { slug = '' } = Astro.params;
const bindings = env as unknown as AppBindings;

let items: ToolItem[] = [];
try {
  const toolsRes = await app.request('/api/v1/tools', {}, bindings);
  if (toolsRes.ok) {
    const body = (await toolsRes.json()) as ToolListResponse;
    items = body.items ?? [];
  } else {
    console.error('tool 取数失败', toolsRes.status);
  }
} catch (error) {
  // 取数失败也按“找不到”处理：给出空态，不白屏。
  console.error('tool 页面取数异常', error);
}

const item = items.find((tool) => tool.slug === slug) ?? null;
if (!item) Astro.response.status = 404;
// 自定义链接工具没有工作台：直接跳到维护者登记的地址。
if (item && item.toolKey === null && item.href) {
  return Astro.redirect(item.href, 302);
}

const index = item ? items.findIndex((tool) => tool.id === item.id) : -1;
const no = index >= 0 ? String(index + 1).padStart(2, '0') : '—';
const total = items.length;
const pageTitle = item ? item.name : '工具不存在';
const toolKey = item?.toolKey ?? null;
---

<SiteLayout title={pageTitle} sticker="PAGE 06 / 07 · 工具" active="tools">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/tools.css" />
  </Fragment>

  <main class="room">
    <div class="wrap">

      {
        item ? (
          <>
            <header class="room-head tool-head">
              <div>
                <div class="room-kicker">
                  <a class="arrow-link tool-back" href="/tools">← 返回工具索引</a>
                  <span class="sticker sticker--paper" title={item.kind}>{item.kind || 'TOOL'}</span>
                </div>
                <h1>{item.name}<span class="hl">。</span></h1>
              </div>
              <div class="room-stats">
                <div class="stat-box is-pink"><span class="k">编号 / NO</span><span class="v">{no}</span></div>
                <div class="stat-box"><span class="k">工具总数 / TOOLS</span><span class="v">{total}<small>件</small></span></div>
              </div>
              <span class="chapter" aria-hidden="true">06</span>
            </header>

            <section class="panel-box bench tool-bench" aria-label={`${item.name} 工作台`}>
              <span class="panel-tab">TOOL {no}</span>
              <div class="bench-in">
                <div class="bench-cap">
                  <span class="bk">WORKBENCH / 工作台</span>
                  <span class="mono">/tools/{item.slug}</span>
                </div>

                {toolKey === 'x-downloader' ? (
                  <section class="bench-body x-tool" id="xTool" data-api={apiBasePath}>
                    <div class="tool-form x-form">
                      <label class="field field--grow">
                        <span class="flabel">推文链接 / TWEET URL</span>
                        <input
                          class="input"
                          id="xUrl"
                          type="text"
                          autocomplete="off"
                          spellcheck="false"
                          aria-label="推文链接"
                        />
                      </label>
                      <div class="field field--action">
                        <span class="flabel" aria-hidden="true">解析 / RESOLVE</span>
                        <button class="btn btn--pink" type="button" id="xResolve">解析 <span class="ar" aria-hidden="true">→</span></button>
                      </div>
                    </div>
                    <p class="tool-hint">支持 x.com / twitter.com 的推文链接，也可直接输入推文 ID。</p>
                    <div class="tool-error" id="xError" role="alert" hidden>
                      <span class="te-k">ERR</span>
                      <span id="xErrorText"></span>
                    </div>
                    <div class="x-result" id="xResult" hidden>
                      <div class="x-author">
                        <img class="x-avatar" id="xAvatar" alt="" hidden />
                        <div class="x-author-body">
                          <div class="x-author-line">
                            <b id="xName"></b>
                            <span class="x-handle" id="xHandle"></span>
                            <span class="x-date" id="xDate" hidden></span>
                          </div>
                          <p class="x-text" id="xText"></p>
                          <div class="x-meta">
                            <a class="x-link" id="xLink" target="_blank" rel="noreferrer noopener"></a>
                            <span id="xSource"></span>
                          </div>
                        </div>
                      </div>
                      <div class="x-media" id="xMedia"></div>
                      <div class="tool-empty" id="xEmpty" hidden>这条推文没有可下载的媒体</div>
                    </div>
                    <p class="tool-note"><b>NOTE</b> 解析与中转下载由服务端完成；若本地网络受限，请优先使用「服务器中转」。仅用于个人学习与备份，请尊重原作者版权。</p>
                  </section>
                ) : toolKey === 'lc-calculator' ? (
                  <section class="bench-body lc-bench" id="lcTool" data-api={apiBasePath}>
                    <div class="lc-card">
                      <div class="lc-cap">
                        <h2>谐振换算</h2>
                        <p>填写 L、C、f 中的任意两个，下方自动显示第三个的计算结果。</p>
                      </div>
                      <div class="tool-form lc-form">
                        <div class="field field--grow">
                          <label class="flabel" for="lcL">电感 L</label>
                          <div class="input-unit">
                            <input class="input" id="lcL" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="电感 L" />
                            <div class="selwrap">
                              <select id="lcLUnit" aria-label="电感单位">
                                <option value="H">H</option>
                                <option value="mH">mH</option>
                                <option value="uH" selected>µH</option>
                                <option value="nH">nH</option>
                                <option value="pH">pH</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                        <div class="field field--grow">
                          <label class="flabel" for="lcC">电容 C</label>
                          <div class="input-unit">
                            <input class="input" id="lcC" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="电容 C" />
                            <div class="selwrap">
                              <select id="lcCUnit" aria-label="电容单位">
                                <option value="F">F</option>
                                <option value="mF">mF</option>
                                <option value="uF">µF</option>
                                <option value="nF">nF</option>
                                <option value="pF" selected>pF</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                        <div class="field field--grow">
                          <label class="flabel" for="lcF">频率 f</label>
                          <div class="input-unit">
                            <input class="input" id="lcF" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="频率 f" />
                            <div class="selwrap">
                              <select id="lcFUnit" aria-label="频率单位">
                                <option value="Hz">Hz</option>
                                <option value="kHz">kHz</option>
                                <option value="MHz" selected>MHz</option>
                                <option value="GHz">GHz</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                        <div class="field field--action">
                          <span class="flabel" aria-hidden="true">重算 / RECALC</span>
                          <button class="btn btn--pink" type="button" id="lcRecalc" disabled title="将计算结果填回对应输入框，并清空另外两个量">重算</button>
                        </div>
                      </div>
                      <div class="lc-result" id="lcResult" hidden>
                        <div class="res-cap"><span class="mono" id="lcResultLabel"></span></div>
                        <div class="res-time" id="lcResultText"></div>
                      </div>
                    </div>

                    <div class="lc-card">
                      <div class="lc-cap">
                        <h2>频率匹配计算</h2>
                        <p>保持电感不变，调整电容把谐振频率从 f₁ 调到 f₂。</p>
                      </div>
                      <div class="tool-form lc-form lc-form--match">
                        <div class="field field--grow">
                          <label class="flabel" for="lcMatchC">当前电容 C₁</label>
                          <div class="input-unit">
                            <input class="input" id="lcMatchC" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="当前电容 C₁" />
                            <div class="selwrap">
                              <select id="lcMatchCUnit" aria-label="电容单位">
                                <option value="F">F</option>
                                <option value="mF">mF</option>
                                <option value="uF">µF</option>
                                <option value="nF">nF</option>
                                <option value="pF" selected>pF</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                        <div class="field field--grow">
                          <label class="flabel" for="lcMatchFrom">当前频率 f₁</label>
                          <div class="input-unit">
                            <input class="input" id="lcMatchFrom" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="当前频率 f₁" />
                            <div class="selwrap">
                              <select id="lcMatchFromUnit" aria-label="当前频率单位">
                                <option value="Hz">Hz</option>
                                <option value="kHz">kHz</option>
                                <option value="MHz" selected>MHz</option>
                                <option value="GHz">GHz</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                        <div class="field field--grow">
                          <label class="flabel" for="lcMatchTo">目标频率 f₂</label>
                          <div class="input-unit">
                            <input class="input" id="lcMatchTo" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="目标频率 f₂" />
                            <div class="selwrap">
                              <select id="lcMatchToUnit" aria-label="目标频率单位">
                                <option value="Hz">Hz</option>
                                <option value="kHz">kHz</option>
                                <option value="MHz" selected>MHz</option>
                                <option value="GHz">GHz</option>
                              </select>
                              <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="lc-result" id="lcMatchResult" hidden>
                        <div class="res-cap"><span class="mono">目标电容 C₂</span></div>
                        <div class="res-time" id="lcMatchText"></div>
                      </div>
                    </div>

                    <p class="tool-note"><b>NOTE</b> 换算在浏览器内完成，不联网、不上传，也不写 D1 / R2。</p>
                  </section>
                ) : toolKey === 'comic-downloader' ? (
                  <section class="bench-body comic-bench" id="comicTool" data-api={apiBasePath}>
                    <div class="tool-form comic-form">
                      <div class="field">
                        <label class="flabel" for="comicPlatform">平台 / PLATFORM</label>
                        <div class="selwrap">
                          <select id="comicPlatform" aria-label="漫画平台"></select>
                          <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                        </div>
                      </div>
                      <label class="field field--grow">
                        <span class="flabel">章节链接 / EPISODE URL</span>
                        <input class="input" id="comicUrl" type="text" autocomplete="off" spellcheck="false" aria-label="章节链接" />
                      </label>
                      <div class="field field--action">
                        <span class="flabel" aria-hidden="true">解析 / RESOLVE</span>
                        <button class="btn btn--pink" type="button" id="comicResolve">解析 <span class="ar" aria-hidden="true">→</span></button>
                      </div>
                    </div>
                    <p class="tool-hint">Champion Cross：请输入 /episodes/ 开头的章节页地址（不是作品目录页）。</p>
                    <div class="tool-error" id="comicError" role="alert" hidden>
                      <span class="te-k">ERR</span><span id="comicErrorText"></span>
                    </div>
                    <div class="comic-result" id="comicResult" hidden>
                      <div class="comic-head">
                        <h2 id="comicSeries"></h2>
                        <p id="comicEpisode"></p>
                      </div>
                      <div class="comic-presets">
                        <button class="comic-preset" type="button" data-preset="current">仅当前章节</button>
                        <button class="comic-preset" type="button" data-preset="around">当前前后各 5 章</button>
                        <button class="comic-preset" type="button" data-preset="all">全部免费章节</button>
                        <button class="comic-preset" type="button" data-preset="none">清空选择</button>
                        <span class="comic-selected" id="comicSelected"></span>
                      </div>
                      <ul class="comic-chapters" id="comicChapters"></ul>
                      <div class="comic-actions">
                        <label class="comic-check"><input type="checkbox" id="comicCombine" checked /> 合并为一个 ZIP</label>
                        <button class="btn btn--pink" type="button" id="comicDownload">下载所选</button>
                        <button class="btn" type="button" id="comicCancel" hidden>取消</button>
                      </div>
                      <div class="comic-progress" id="comicProgress" hidden>
                        <div class="cp-cap"><span id="comicProgressLabel"></span><span id="comicProgressPages"></span></div>
                        <div class="cp-bar"><span class="cp-fill" id="comicProgressFill"></span></div>
                      </div>
                      <div class="tool-ok" id="comicDone" role="status" hidden>
                        <span class="te-k">DONE</span><span id="comicDoneText"></span>
                      </div>
                    </div>
                    <p class="tool-note"><b>NOTE</b> 图片在浏览器中本地解密并打包，不会上传到服务器；仅支持当前可免费阅读的章节；请遵守目标网站服务条款，仅用于个人备份。</p>
                  </section>
                ) : (
                  <div class="bench-body">
                    <div class="bench-empty">
                      <span class="sticker sticker--paper">NO PANEL / 未配置</span>
                      <h2>这个工具还没有工作台<span class="hl">。</span></h2>
                      <p>后台登记的 toolKey 不是内置工作台；可以到后台「工具」里重新选择，或去工具索引看看其他抽屉。</p>
                      <a class="arrow-link" href="/tools">返回工具索引 <span class="ar" aria-hidden="true">→</span></a>
                    </div>
                  </div>
                )}
              </div>
            </section>

          </>
        ) : (
          <section class="panel-box bench tools-missing" aria-label="工具不存在">
            <span class="panel-tab">404 / TOOL</span>
            <div class="bench-in">
              <div class="bench-empty">
                <span class="sticker sticker--paper">NO DRAWER / 空台</span>
                <h1>工具不存在<span class="hl">。</span></h1>
                <p>这个地址没有对应的工具；可能已经删掉、改了 slug，或者还没有启用。</p>
                <a class="arrow-link" href="/tools">返回工具索引 <span class="ar" aria-hidden="true">→</span></a>
              </div>
            </div>
          </section>
        )
      }

    </div>
  </main>

  {toolKey === 'x-downloader' && <script is:inline src="/js/pages/tool-x.js"></script>}
  {toolKey === 'lc-calculator' && <script is:inline src="/js/pages/tool-lc.js"></script>}
  {toolKey === 'comic-downloader' && <script is:inline src="/js/pages/tool-comic-zip.js"></script>}
  {toolKey === 'comic-downloader' && <script is:inline src="/js/pages/tool-comic-unscramble.js"></script>}
  {toolKey === 'comic-downloader' && <script is:inline src="/js/pages/tool-comic.js"></script>}
</SiteLayout>
