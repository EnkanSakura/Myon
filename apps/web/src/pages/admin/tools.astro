---
// 后台 · 工具：列表从 /api/v1/admin/tools 读取，页面内完成增删改与启停。
// 样式：public/css/pages/admin-tools.css；脚本：public/js/pages/admin-tools.js
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

// 接口地址由服务端渲染给页面脚本，public/js 里不硬编码。
const toolsApi = `${apiBasePath}/admin/tools`;
---

<AdminLayout title="工具" crumb="工具" active="tools">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/admin-tools.css" />
  </Fragment>

  <div class="page" data-api={toolsApi}>

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">06</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CONSOLE · 06</span>
          <span class="sticker sticker--paper">TOOLS / DRAWER</span>
        </div>
        <h1>工具<span class="dot">。</span></h1>
        <p class="pdate">共 <span id="pTotal">—</span> 个工具 <span class="sep">·</span> 启用中 <span id="pEnabled">—</span> <span class="sep">·</span> 最近更新 <span id="pUpdated">—</span></p>
      </div>

      <div class="ph-r">
        <div class="acts">
          <button class="btn btn--pink" type="button" id="btnNewTool" disabled>新增工具 <span class="ar" aria-hidden="true">＋</span></button>
        </div>
      </div>
    </header>

    <!-- ---------- 连接 / 错误提示 ---------- -->
    <div class="notice notice--info" id="tbanner" role="status" hidden>
      <span class="notice-k" id="bannerK">INFO</span>
      <div class="notice-c">
        <b id="bannerTitle"></b>
        <p id="bannerText"></p>
        <ul class="notice-issues" id="bannerIssues" hidden></ul>
      </div>
      <button class="notice-btn" id="bannerToken" type="button" data-token-open hidden>管理令牌</button>
      <button class="notice-btn" id="bannerRetry" type="button" hidden>重试</button>
    </div>

    <!-- ---------- 统计 ---------- -->
    <section class="metrics" aria-label="工具统计">
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>工具总数 / TOOLS</div>
        <div class="m-v" id="mTotal">—</div>
        <div class="m-f">后台与前台 /tools 共用同一份工具</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>启用中 / ENABLED</div>
        <div class="m-v" id="mEnabled">—</div>
        <div class="m-f">启用项会出现在前台 /tools</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>停用 / DISABLED</div>
        <div class="m-v" id="mDisabled">—</div>
        <div class="m-f">停用只是收起入口 <span class="msep">·</span>不删工具</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>最近更新 / UPDATED</div>
        <div class="m-v m-v--word" id="mUpdated">—</div>
        <div class="m-f" id="mUpdatedNote">所有工具的 updatedAt 取最大值</div>
      </div>
    </section>

    <!-- ---------- 01 工具列表 ---------- -->
    <section class="sec" id="tools" aria-labelledby="h-tools">
      <div class="sec-h">
        <span class="sec-num">01</span>
        <h2 id="h-tools">工具列表</h2>
        <span class="sec-en" id="secEn">TOOLS / —</span>
        <div class="sec-r">
          <span class="sec-note">启用中 <b id="enabledCount">—</b> / <span id="totalCount">—</span></span>
          <span class="sec-note">启用状态即时生效 · 前台地址是 /tools/&lt;slug&gt;</span>
        </div>
      </div>

      <p class="list-state" id="listState">正在读取工具…</p>

      <div class="tbl-wrap" id="tblWrap" hidden>
        <table class="tbl tools-tbl">
          <caption class="sr-only">后台工具列表</caption>
          <colgroup>
            <col style="width:62px" />
            <col />
            <col style="width:250px" />
            <col style="width:132px" />
            <col style="width:168px" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="c-no">编号</th>
              <th scope="col">名称 · 说明</th>
              <th scope="col">类型</th>
              <th scope="col" class="c-sw">状态</th>
              <th scope="col" class="c-ops">操作</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>

      <div class="empty" id="empty" hidden>
        <span class="empty-k">TOOLS</span>
        <div class="empty-c"><p class="empty-d" id="emptyText">还没有工具。</p></div>
        <div class="empty-actions"><button class="btn" id="emptyBtn" type="button">新增工具</button></div>
      </div>
    </section>

  </div>

  <!-- ---------- 新增 / 编辑工具 ---------- -->
  <dialog class="dlg tool-dlg" id="toolDlg" aria-labelledby="toolDlgTitle">
    <form class="dlg-box tool-box" id="toolForm" novalidate>
      <span class="dlg-tab" id="toolDlgTab">TOOL / 工具</span>
      <div class="dlg-h">
        <span id="toolDlgTitle">新增工具</span>
        <span id="toolDlgState">未保存</span>
      </div>

      <div class="tool-banner" id="formBanner" role="status" hidden>
        <span class="tool-banner-k" id="formBannerK">ERR</span>
        <div class="tool-banner-c">
          <b id="formBannerTitle"></b>
          <p id="formBannerText"></p>
          <ul class="tool-issues" id="formIssues" hidden></ul>
        </div>
      </div>

      <div class="tool-fields">
        <div class="tf tf--wide">
          <label for="fName">名称 / NAME</label>
          <input class="p-in" id="fName" type="text" maxlength="60" placeholder="例如：正则测试" autocomplete="off" required />
        </div>
        <div class="tf tf--wide">
          <label for="fSlug">地址 / SLUG</label>
          <input class="p-in" id="fSlug" type="text" maxlength="40" placeholder="timestamp" spellcheck="false" autocomplete="off" required />
          <p class="tf-note">用在 /tools/ 后面 · 只能小写字母、数字、连字符，例：timestamp</p>
        </div>
        <div class="tf tf--wide">
          <label for="fDesc">一句说明 / DESC</label>
          <textarea class="p-in tf-area" id="fDesc" rows="2" maxlength="200" placeholder="一句话说清它做什么"></textarea>
        </div>
        <div class="tf">
          <label for="fKind">类型 / KIND</label>
          <input class="p-in" id="fKind" type="text" maxlength="80" placeholder="例如：UNIX TIME · 浏览器内换算" autocomplete="off" />
        </div>
        <div class="tf">
          <label for="fKeywords">关键词 / KEYWORDS</label>
          <input class="p-in" id="fKeywords" type="text" maxlength="200" placeholder="空格分隔，例如：时间戳 unix 时区" autocomplete="off" />
        </div>
        <div class="tf">
          <label for="fKey">内置工具 / TOOL KEY</label>
          <select class="p-in" id="fKey">
            <option value="">自定义链接</option>
            <option value="ts">时间戳转换 · ts</option>
            <option value="img">图片压缩 · img</option>
            <option value="md">Markdown 预览 · md</option>
            <option value="color">配色生成 · color</option>
            <option value="bgm">追番时刻表 · bgm</option>
            <option value="json">JSON 格式化 · json</option>
            <option value="redirect">旧域名跳转 · redirect</option>
            <option value="short">短链接 · short</option>
          </select>
        </div>
        <div class="tf">
          <label for="fHref">链接 / HREF</label>
          <input class="p-in" id="fHref" type="text" maxlength="300" placeholder="/tools 或 https://…" spellcheck="false" autocomplete="off" />
        </div>
        <div class="tf tf--pos">
          <label for="fPosition">排序 / POSITION</label>
          <input class="p-in" id="fPosition" type="number" min="0" max="9999" step="1" value="0" />
        </div>
        <div class="tf tf--check">
          <label class="tf-check" for="fEnabled">
            <input id="fEnabled" type="checkbox" checked />
            <span>启用 · 前台 /tools 可见</span>
          </label>
        </div>
      </div>

      <p class="tf-hint" id="formHint">内置工具选一个 key 即可；「自定义链接」需要填链接。</p>

      <div class="dlg-f">
        <span class="dlg-c" id="formMeta">保存后立即生效</span>
        <div class="dlg-a">
          <button class="p-btn" type="button" id="formCancel">取消</button>
          <button class="p-btn p-btn--pub" type="submit" id="formSave">创建工具</button>
        </div>
      </div>
    </form>
  </dialog>

  <!-- ---------- 删除确认 ---------- -->
  <dialog class="dlg del-dlg" id="delDlg" aria-labelledby="delTitle">
    <div class="dlg-box">
      <span class="dlg-tab">DELETE / 删除</span>
      <div class="del-head">
        <span class="sec-num">!</span>
        <h2 class="del-title" id="delTitle">删除这个工具？</h2>
      </div>
      <p class="del-text">删除后前台 /tools 会立刻少一个入口，操作不可撤销。</p>
      <p class="del-target" id="delTarget"></p>
      <div class="dlg-f">
        <span class="dlg-c">只删这一条 · 不影响其他工具</span>
        <div class="dlg-a">
          <button class="p-btn" type="button" id="delCancel">取消</button>
          <button class="p-btn p-btn--pub" type="button" id="delOk">删除</button>
        </div>
      </div>
    </div>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline src="/js/pages/admin-tools.js"></script>
</AdminLayout>
