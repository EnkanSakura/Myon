---
// 后台媒体库：图片文件在 R2，分类/别名等元数据在 D1（/api/v1/admin/media*），
// 令牌只存在浏览器 localStorage。改分类/别名不会改变图片 URL（R2 key 不含分类）。
// 样式：public/css/pages/admin-media.css；脚本：public/js/pages/admin-media.js
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

const mediaApi = `${apiBasePath}/admin/media`;
const categoriesApi = `${mediaApi}/categories`;
const gifWebpApi = `${mediaApi}/gif-webp`;
const statsApi = `${apiBasePath}/stats`;
const mediaBase = '/media/';
---

<AdminLayout
  title="媒体库"
  crumb="媒体库"
  active="media"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/admin-media.css" />
  </Fragment>

<div class="page" data-api={mediaApi} data-categories-api={categoriesApi} data-gif-api={gifWebpApi} data-stats-api={statsApi} data-media-base={mediaBase}>

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">08</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CONSOLE · 08</span>
          <span class="sticker sticker--paper">资源 / MEDIA</span>
        </div>
        <h1>媒体库<span class="dot">。</span></h1>
        <p class="pdate">共 <b id="sumFiles">—</b> 个文件 <span class="sep">·</span> 分类 / 别名存 D1 <span class="sep">·</span> 单张上限 8MB</p>
      </div>

      <div class="ph-r">
        <div class="acts up-acts">
          <button class="btn" id="btnCats" type="button">管理分类</button>
          <label class="fb-sort">上传到
            <select id="uploadCategory" aria-label="上传到哪个分类">
              <option value="">未分类</option>
            </select>
          </label>
          <button class="btn btn--pink" id="btnUpload" type="button">上传 <span class="ar" aria-hidden="true">＋</span></button>
          <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml" multiple hidden>
        </div>
      </div>
    </header>

    <!-- ---------- 连接 / 授权提示 ---------- -->
    <div class="notice notice--info" id="authBanner" role="status" hidden>
      <span class="notice-k" id="authK">INFO</span>
      <div class="notice-c">
        <b id="authTitle"></b>
        <p id="authText"></p>
      </div>
      <button class="notice-btn" id="authToken" type="button" data-token-open hidden>管理令牌</button>
    </div>

    <!-- ---------- 本页概览（R2 用量需在 Cloudflare 控制台看） ---------- -->
    <section class="storage" aria-label="媒体概览">
      <div class="st-top">
        <div>
          <div class="st-k"><i aria-hidden="true"></i>MEDIA / 本页概览</div>
          <b class="st-n" id="stLine">正在读取…</b>
        </div>
        <div class="st-p"><span id="stCount">—</span><small>个文件 / 本页</small></div>
      </div>
      <div class="st-bar" role="img" aria-label="本页图片与其它文件占比">
        <span class="st-seg st-seg--img" id="stImgSeg" style="width:0%"></span>
        <span class="st-seg st-seg--att" id="stAttSeg" style="width:0%"></span>
        <span class="st-seg st-seg--free"></span>
      </div>
      <div class="st-legend">
        <span><i class="lg-img" aria-hidden="true"></i>图片 <b id="stImg">0</b></span>
        <span><i class="lg-att" aria-hidden="true"></i>其它 <b id="stAtt">0</b></span>
        <span><i class="lg-other" aria-hidden="true"></i>合计 <b id="stSize">0 B</b></span>
        <span><i class="lg-free" aria-hidden="true"></i>单张上限 8MB</span>
      </div>
    </section>

    <!-- ---------- 筛选栏 ---------- -->
    <div class="filterbar" aria-label="筛选媒体">
      <div class="fb-chips" id="catChips" role="group" aria-label="按分类筛选"></div>

      <label class="fb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M15.6 15.6 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sr-only">全库搜索文件名或别名</span>
        <input id="q" type="search" autocomplete="off" spellcheck="false">
      </label>

      <label class="fb-sort">排序
        <select id="sortSel">
          <option value="added">最近上传</option>
          <option value="size">最大文件</option>
          <option value="name">名称 A→Z</option>
        </select>
      </label>

      <span class="fb-count" id="fbCount" aria-live="polite">全库筛选：—</span>
      <button class="fb-clear" id="clearFilters" type="button">清除</button>
    </div>

    <!-- ---------- 上传队列 ---------- -->
    <div class="up-list" id="upList" hidden aria-live="polite"></div>

    <!-- ---------- 媒体网格 ---------- -->
    <div class="m-loading" id="mLoading">
      <span class="sticker sticker--paper">LOADING</span>
      <p>正在读取媒体库…</p>
    </div>

    <div class="media-grid" id="mediaGrid" aria-busy="true"></div>

    <div class="empty" id="empty" hidden>
      <div class="empty-c"><p class="empty-d" id="emptyText">没有符合条件的文件。换个分类或关键词试试。</p></div>
      <div class="empty-actions"><button class="btn" id="emptyReset" type="button">清除筛选</button></div>
    </div>

    <!-- ---------- 批量条 ---------- -->
    <div class="batch" id="batch" hidden>
      <span class="batch-n">已选择 <b id="batchN">0</b> 项</span>
      <button class="batch-btn" type="button" data-act="copy">复制链接</button>
      <button class="batch-btn batch-btn--del" type="button" data-act="del">删除</button>
      <button class="batch-clear" type="button" id="batchClear">取消选择</button>
    </div>

    <!-- ---------- 分页 ---------- -->
    <div class="pager">
      <span class="pager-info">第 <b id="pgNow">—</b> 页 <span class="sep">/</span> 共 <b id="pgPages">—</b> 页 <span class="sep">·</span> 每页 <span id="pgSize">30</span> 个 <span class="sep">·</span> 共 <b id="pgTotal">—</b> 个文件</span>
      <div class="pager-btns">
        <button class="pager-btn" id="pgPrev" type="button" aria-label="上一页" disabled>← 上页</button>
        <span class="pager-nums" id="pgNums"></span>
        <button class="pager-btn" id="pgNext" type="button" aria-label="下一页" disabled>下页 →</button>
      </div>
    </div>

    <div class="page-mark">
      <span>P.08 / MEDIA — 媒体文件</span>
      <span>分类与别名只存 D1 · 改名/移动不改图片 URL · 别名最多 8 个（每个 ≤30 字）</span>
    </div>

  </div>

<!-- ---------- 分类管理 ---------- -->
<dialog class="dlg cat-dlg" id="catDlg" aria-labelledby="catDlgTitle">
  <div class="dlg-box">
    <span class="dlg-tab">MEDIA / 分类</span>
    <div class="dlg-h"><span id="catDlgTitle">管理分类</span><span>D1 · 图片 URL 不变</span></div>
    <p class="dlg-c cat-note">分类只存在 D1；改名、调整顺序不会改变图片地址。删除分类后，该分类下的图片会移到「未分类」。</p>
    <div class="cat-list" id="catList"></div>
    <p class="empty empty--inline" id="catEmpty" hidden>还没有分类，先新建一个。</p>
    <div class="cat-add">
      <label class="sr-only" for="catName">新分类名称</label>
      <input class="token-input cat-name-input" id="catName" type="text" maxlength="24" spellcheck="false" autocomplete="off">
      <button class="p-btn p-btn--pub" id="catAdd" type="button">添加分类</button>
    </div>
    <p class="fld-err" id="catErr" hidden></p>
    <div class="dlg-f">
      <span class="dlg-c" id="catState">—</span>
      <div class="dlg-a"><button class="p-btn" id="catClose" type="button">关闭</button></div>
    </div>
  </div>
</dialog>

<!-- ---------- 删除分类确认 ---------- -->
<dialog class="dlg" id="catDelDlg" aria-labelledby="catDelTitle">
  <div class="dlg-box">
    <span class="dlg-tab">DANGER</span>
    <div class="dlg-h"><span id="catDelTitle">确认删除分类</span><span>DELETE</span></div>
    <p class="cfm-p" id="catDelText">删除后，该分类下的图片会移到「未分类」。</p>
    <div class="dlg-f">
      <span class="dlg-c">图片文件不会被删除</span>
      <div class="dlg-a">
        <button class="p-btn" id="catDelCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub del-ok" id="catDelOk" type="button">删除分类</button>
      </div>
    </div>
  </div>
</dialog>

<!-- ---------- 分类 / 别名（单张图片） ---------- -->
<dialog class="dlg meta-dlg" id="metaDlg" aria-labelledby="metaDlgTitle">
  <form class="dlg-box" id="metaForm" novalidate>
    <span class="dlg-tab">MEDIA / 归类</span>
    <div class="dlg-h"><span id="metaDlgTitle">分类与别名</span><span>PATCH / 媒体</span></div>
    <p class="dlg-c meta-target" id="metaTarget">—</p>
    <label class="token-label" for="metaCategory">分类 / CATEGORY</label>
    <select id="metaCategory" class="meta-select" aria-label="图片分类">
      <option value="">未分类</option>
    </select>
    <label class="token-label meta-alias-label" for="metaAliases">别名 / ALIASES</label>
    <input class="token-input meta-input" id="metaAliases" type="text" maxlength="250" spellcheck="false" autocomplete="off">
    <p class="hint">逗号或顿号分隔，最多 8 个、每个 30 字以内；保存后可按别名全库搜索。分类与别名只存 D1，不改图片 URL。</p>
    <p class="fld-err" id="metaErr" hidden></p>
    <div class="dlg-f">
      <span class="dlg-c" id="metaState">—</span>
      <div class="dlg-a">
        <button class="p-btn" id="metaCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub" id="metaSave" type="submit">保存</button>
      </div>
    </div>
  </form>
</dialog>

<!-- ---------- 删除确认 ---------- -->
<dialog class="dlg" id="delDlg" aria-labelledby="delDlgTitle">
  <div class="dlg-box">
    <span class="dlg-tab">DANGER</span>
    <div class="dlg-h"><span id="delDlgTitle">确认删除</span><span>DELETE / 不可撤销</span></div>
    <p class="cfm-p" id="delDlgText">删除后不可恢复。</p>
    <div class="dlg-f">
      <span class="dlg-c">删除后不可恢复</span>
      <div class="dlg-a">
        <button class="p-btn" id="delCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub del-ok" id="delOk" type="button">删除</button>
      </div>
    </div>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline src="/js/image-upload.js"></script>
  <script is:inline src="/js/pages/admin-media.js"></script>
</AdminLayout>
