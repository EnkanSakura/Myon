---
// 后台 · 文章台账：列表从 /api/v1/admin/posts 读取，页面内完成增删改。
// 样式：public/css/pages/admin-articles.css；脚本：public/js/pages/admin-articles.js
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mediaUrl } from '../../lib/media';

// 接口地址由服务端渲染给页面脚本，public/js 里不硬编码。
const postsApi = `${apiBasePath}/admin/posts`;
// 分类候选的全站来源（统计接口的 categories.posts），脚本只读，不需要令牌。
const statsApi = `${apiBasePath}/stats`;
// 正文编辑器的图片按钮复用共享媒体选择器，需要媒体接口与地址前缀。
const mediaApi = `${apiBasePath}/admin/media`;
const gifWebpApi = `${mediaApi}/gif-webp`;
// 图片预览的 URL 规则来自 mediaUrl()，脚本只负责把 key 拼回去。
const mediaSample = mediaUrl('__KEY__');
const mediaBase = mediaSample ? mediaSample.replace('__KEY__', '') : '';
---

<AdminLayout title="文章" crumb="文章" active="articles">
  <Fragment slot="head">
    <!-- 预览要还原前台文章正文：先加载文章正文样式，再加载本页布局，保证本页排在最后。 -->
    <link rel="stylesheet" href="/css/pages/article.css" />
    <link rel="stylesheet" href="/css/pages/admin-articles.css" />
  </Fragment>

  <div
    class="page"
    data-api={postsApi}
    data-api-stats={statsApi}
    data-api-media={mediaApi}
    data-gif-api={gifWebpApi}
    data-media-base={mediaBase}
  >

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">08</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CONSOLE · 08</span>
          <span class="sticker sticker--paper">内容 / ARTICLES</span>
        </div>
        <h1>文章<span class="dot">。</span></h1>
        <p class="pdate">共 <span id="sumAll">—</span> 篇 <span class="sep">·</span> 最后更新 <span id="sumUpdated">—</span></p>
      </div>

      <div class="ph-r">
        <div class="acts">
          <button class="btn btn--pink" id="btnNew" type="button">新建文章 <span class="ar" aria-hidden="true">＋</span></button>
          <button class="btn" id="btnImport" type="button">导入 Markdown</button>
          <button class="btn" id="btnExport" type="button">导出</button>
          <input type="file" id="mdInput" accept=".md,.markdown,text/markdown" hidden />
        </div>
      </div>
    </header>

    <!-- ---------- 连接 / 错误提示 ---------- -->
    <div class="notice notice--info" id="listBanner" role="status" hidden>
      <span class="notice-k" id="bannerK">INFO</span>
      <div class="notice-c">
        <b id="bannerTitle"></b>
        <p id="bannerText"></p>
        <ul class="notice-issues" id="bannerIssues" hidden></ul>
      </div>
      <button class="notice-btn" id="bannerToken" type="button" data-token-open hidden>管理令牌</button>
      <button class="notice-btn" id="bannerRetry" type="button" hidden>重试</button>
    </div>

    <!-- ---------- 筛选栏 ---------- -->
    <div class="filterbar" aria-label="筛选文章">
      <div class="fb-chips" role="group" aria-label="按状态筛选">
        <button class="chip is-on" type="button" data-status="all" aria-pressed="true">全部</button>
        <button class="chip" type="button" data-status="published" aria-pressed="false">已发布</button>
        <button class="chip" type="button" data-status="draft" aria-pressed="false">草稿</button>
        <button class="chip" type="button" data-status="archived" aria-pressed="false">归档</button>
      </div>

      <label class="fb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M15.6 15.6 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sr-only">搜索文章标题或 slug</span>
        <input id="q" type="search" placeholder="搜索标题 / slug" autocomplete="off" spellcheck="false" />
      </label>

      <label class="fb-sort">分类
        <select id="catSel">
          <option value="all">全部分类</option>
        </select>
      </label>
      <label class="fb-sort">排序
        <select id="sortSel">
          <option value="update">最近更新</option>
          <option value="title">标题 A→Z</option>
        </select>
      </label>

      <span class="fb-count" id="fbCount" aria-live="polite">显示 —</span>
      <button class="fb-clear" id="clearFilters" type="button">清除</button>
    </div>

    <p class="list-state" id="listState">正在读取文章…</p>

    <!-- ---------- 表格 ---------- -->
    <div class="tbl-wrap" id="tblWrap" hidden>
      <table class="tbl tbl--articles">
        <caption class="sr-only">后台文章列表</caption>
        <colgroup>
          <col />
          <col style="width:150px" />
          <col style="width:88px" />
          <col style="width:98px" />
          <col style="width:112px" />
          <col style="width:116px" />
          <col style="width:168px" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">标题</th>
            <th scope="col">slug</th>
            <th scope="col">分类</th>
            <th scope="col">状态</th>
            <th scope="col">更新时间</th>
            <th scope="col" class="r">字数 / 阅读</th>
            <th scope="col" class="c-ops r">操作</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>

    <div class="empty" id="empty" hidden>
      <div class="empty-c"><p class="empty-d" id="emptyText">还没有文章。</p></div>
      <div class="empty-actions"><button class="btn" id="emptyBtn" type="button">新建文章</button></div>
    </div>

    <!-- ---------- 分页 ---------- -->
    <div class="pager" id="pager" hidden>
      <span class="pager-info">第 <b id="pgNow">1</b> 页 <span class="sep">/</span> 共 <b id="pgCount">1</b> 页 <span class="sep">·</span> 每页 20 条 <span class="sep">·</span> 共 <b id="pgTotal">0</b> 条</span>
      <div class="pager-btns">
        <button class="pager-btn" id="pgPrev" type="button" aria-label="上一页" disabled>← 上页</button>
        <span class="pager-nums" id="pgNums"></span>
        <button class="pager-btn" id="pgNext" type="button" aria-label="下一页" disabled>下页 →</button>
      </div>
    </div>

    <div class="page-mark">
      <span>P.08 / ARTICLES — 台账</span>
      <span>标题 → slug → 状态 → 字数</span>
    </div>
  </div>

  <!-- ---------- 新建 / 编辑文章 ---------- -->
  <dialog class="dlg post-dlg" id="postDlg" aria-labelledby="postDlgTitle">
    <form class="dlg-box post-box" id="postForm" novalidate>
      <span class="dlg-tab">ARTICLE / 文章</span>
      <div class="post-head">
        <span class="sec-num" id="postDlgNo">NEW</span>
        <h2 class="post-title" id="postDlgTitle">新建文章</h2>
        <span class="post-dlg-state" id="postDlgState">未保存</span>
      </div>

      <div class="post-banner" id="formBanner" role="status" hidden>
        <span class="post-banner-k" id="formBannerK">ERR</span>
        <div class="post-banner-c">
          <b id="formBannerTitle"></b>
          <p id="formBannerText"></p>
          <ul class="post-issues" id="formIssues" hidden></ul>
        </div>
      </div>

      <!-- 元数据压成三行，把高度让给正文的编辑 / 预览面板 -->
      <div class="post-fields">
        <div class="pf pf--wide">
          <label for="fTitle">标题 / TITLE</label>
          <input id="fTitle" type="text" maxlength="200" autocomplete="off" required />
        </div>
        <div class="pf">
          <label for="fSlug">slug / SLUG</label>
          <input id="fSlug" type="text" maxlength="120" spellcheck="false" autocomplete="off" required />
          <p class="pf-hint">小写字母、数字、连字符</p>
        </div>
        <div class="pf">
          <label for="fCategory">分类 / CATEGORY</label>
          <div class="combo" id="categoryCombo">
            <input id="fCategory" type="text" maxlength="40" autocomplete="off" required role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="catList" />
            <button class="combo-toggle" id="fCategoryToggle" type="button" aria-label="展开已有分类" aria-expanded="false"></button>
            <div class="combo-list" id="catList" role="listbox" aria-label="已有分类" hidden></div>
          </div>
          <p class="pf-hint">可从已有分类里选，也可以新建</p>
        </div>
        <div class="pf">
          <label for="fStatus">状态 / STATUS</label>
          <select id="fStatus">
            <option value="draft">草稿</option>
            <option value="published">已发布</option>
            <option value="archived">归档</option>
          </select>
        </div>
        <div class="pf pf--wide">
          <label for="fExcerpt">摘要 / EXCERPT</label>
          <textarea id="fExcerpt" rows="2" maxlength="400"></textarea>
        </div>
      </div>

      <!-- 正文：与「关于」编辑页一致的 Markdown 双栏（左编辑 + 右实时预览，长相在共享 .md-*） -->
      <div class="md-split post-md">
        <section class="md-panel" aria-labelledby="fBodyLabel">
          <div class="md-panel-head">
            <span class="sec-num">01</span>
            <h2 id="fBodyLabel">编辑器</h2>
            <span class="md-panel-en">MARKDOWN</span>
            <span class="md-panel-file">body.md</span>
          </div>
          <div class="md-panel-body md-panel-body--editor">
            <label class="sr-only" for="fBody">正文 Markdown 内容</label>
            <textarea class="md-input" id="fBody" maxlength="200000" spellcheck="false" placeholder="## 小标题&#10;&#10;正文段落……&#10;&#10;- 列表项&#10;- [ ] 任务项"></textarea>
          </div>
          <div class="md-panel-foot">
            <span>工具栏插入语法；公式 / 提醒框 / 剧透 / 网格 / GitHub 卡片在工具栏末组</span>
            <span id="bodyHint">0 字 · 约 1 分钟</span>
          </div>
        </section>

        <section class="md-panel" aria-labelledby="fPreviewLabel">
          <div class="md-panel-head">
            <span class="sec-num">02</span>
            <h2 id="fPreviewLabel">预览</h2>
            <span class="md-panel-en">LIVE</span>
            <span class="md-panel-file">前台文章页</span>
          </div>
          <div class="md-panel-body md-panel-body--preview is-page">
            <!-- 文章预览按「前台文章页的一页纸」排版：没有纸卡边框/阴影，正文排版来自 article.css 的 .body -->
            <div class="art-preview"><div class="body" id="fPreview"></div></div>
          </div>
          <div class="md-panel-foot">
            <span>与前台文章页同款排版；省略目录 / 阅读进度 / 复制按钮</span>
          </div>
        </section>
      </div>

      <div class="post-foot">
        <span class="post-meta" id="postMeta">新增的文章默认存为草稿 · 发布后前台可见</span>
        <div class="post-actions">
          <button class="p-btn" id="formCancel" type="button">取消</button>
          <button class="p-btn p-btn--pub" id="formSave" type="submit">创建文章</button>
        </div>
      </div>
    </form>
  </dialog>

  <!-- ---------- 删除确认 ---------- -->
  <dialog class="dlg del-dlg" id="delDlg" aria-labelledby="delDlgTitle">
    <div class="dlg-box">
      <span class="dlg-tab">DELETE / 删除</span>
      <div class="del-head">
        <span class="sec-num">!</span>
        <h2 class="del-title" id="delDlgTitle">删除这篇文章？</h2>
      </div>
      <p class="del-text">删除后文章会从前台和后台一起消失，操作不可撤销。</p>
      <p class="del-target" id="delTarget"></p>
      <div class="del-f">
        <button class="p-btn" id="delCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub" id="delOk" type="button">删除</button>
      </div>
    </div>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- 预览公式：模块脚本延迟执行，准备好后通知编辑器重渲染一次 -->
  <script>
    import katex from 'katex';
    Object.assign(window, { MyonKatex: katex });
    document.dispatchEvent(new Event('myon:katex-ready'));
  </script>

  <!-- 共享脚本顺序：图片处理 → Markdown 渲染 → 媒体选择器 → 编辑器 → 本页逻辑（combo.js 由 AdminLayout 预加载） -->
  <script is:inline src="/js/image-upload.js"></script>
  <script is:inline src="/js/markdown.js"></script>
  <script is:inline src="/js/media-picker.js"></script>
  <script is:inline src="/js/markdown-editor.js"></script>
  <script is:inline src="/js/pages/admin-articles.js"></script>
</AdminLayout>
