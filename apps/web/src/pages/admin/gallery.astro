---
// 后台展柜：真实 D1 增删改查（/api/v1/admin/gallery），令牌只存在浏览器 localStorage。
// 样式：public/css/pages/admin-gallery.css；脚本：public/js/pages/admin-gallery.js
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

// 接口地址由服务端渲染给页面脚本，public/js 里不硬编码。
const galleryApi = `${apiBasePath}/admin/gallery`;
const statsApi = `${apiBasePath}/stats`;
---

<AdminLayout
  title="展柜"
  crumb="展柜"
  active="gallery"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/admin-gallery.css" />
  </Fragment>

<div class="page" data-api={galleryApi} data-stats-api={statsApi}>

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">C.04</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CABINET / ADMIN</span>
          <span class="sticker sticker--paper">已陈列 <span id="stickerShown">—</span></span>
        </div>
        <h1>展柜<span class="dot">。</span></h1>
        <p class="pdate">共 <b id="gTotal">—</b> 件 <span class="sep">·</span> <span id="gCats">正在读取…</span> <span class="sep">·</span> 已陈列 <b id="gShown">—</b></p>
      </div>

      <div class="ph-r">
        <div class="acts">
          <button class="btn btn--pink" id="btnAdd" type="button">新增藏品 <span class="ar" aria-hidden="true">＋</span></button>
          <a class="btn" href="/gallery">看前台展柜 <span class="ar" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>

    <!-- ---------- 管理令牌 ---------- -->
    <section class="tk-bar" aria-label="管理令牌">
      <span class="tk-k">TOKEN / 管理令牌</span>
      <label class="sr-only" for="tokenInput">管理令牌</label>
      <input class="tk-input" id="tokenInput" type="password" placeholder="ADMIN_TOKEN" autocomplete="current-password" spellcheck="false">
      <button class="tk-btn" id="tokenSave" type="button">保存令牌</button>
      <button class="tk-btn" id="tokenClear" type="button">清除</button>
      <span class="tk-state" id="tokenState">未填写</span>
    </section>

    <div class="notice notice--info" id="authBanner" role="status" hidden>
      <span class="notice-k" id="authK">INFO</span>
      <div class="notice-c">
        <b id="authTitle"></b>
        <p id="authText"></p>
      </div>
    </div>

    <!-- ---------- 01 分类 ---------- -->
    <section class="sec" aria-labelledby="h-cats">
      <div class="sec-h">
        <span class="sec-num">01</span>
        <h2 id="h-cats">分类</h2>
        <span class="sec-en">CATEGORIES</span>
        <div class="sec-r"><span class="sec-note">筛选只在当前页内做 · 计数按本页</span></div>
      </div>

      <div class="cats" role="group" aria-label="按分类筛选藏品">
        <span class="cat-btns" id="catBtns"></span>
        <span class="cats-note" id="galCount" aria-live="polite">正在读取…</span>
      </div>
    </section>

    <!-- ---------- 02 藏品 ---------- -->
    <section class="sec" aria-labelledby="h-items">
      <div class="sec-h">
        <span class="sec-num">02</span>
        <h2 id="h-items">藏品</h2>
        <span class="sec-en">ITEMS / GRID</span>
        <div class="sec-r">
          <span class="sec-note" id="galPageNote">正在读取…</span>
          <a class="arrow-link" href="/gallery">前台展柜 <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="gal-body">
        <div class="gal-main">
          <div class="gal-toolbar">
            <span class="gal-count">已陈列 <b id="shownCount">—</b> / <span id="totalCount">—</span> 件</span>
            <label class="gal-sort">排序
              <select id="galSortSelect" aria-label="藏品排序">
                <option value="slot">按柜位</option>
                <option value="new">最近入藏</option>
                <option value="name">按名称</option>
              </select>
            </label>
          </div>

          <div class="gal-grid" id="galGrid" aria-busy="true"></div>

          <div class="gal-loading" id="galLoading" hidden>
            <span class="sticker sticker--paper">LOADING</span>
            <p>正在读取展柜…</p>
          </div>

          <div class="empty" id="galState" hidden>
            <span class="empty-k" id="galStateK">EMPTY</span>
            <div class="empty-c">
              <b class="empty-t" id="galStateTitle">展柜还空着</b>
              <p class="empty-d" id="galStateText">还没有藏品，点右上角「新增藏品」放第一件进来。</p>
            </div>
            <div class="empty-actions"><button class="g-act" id="galRetry" type="button">重新读取</button></div>
          </div>

          <div class="pager">
            <span class="pager-info">第 <b id="pgNow">—</b> / <span id="pgPages">—</span> 页 · 每页 <span id="pgSize">20</span> 件 · 共 <b id="pgTotal">—</b> 件</span>
            <div class="pager-btns">
              <button class="pager-btn" id="pgPrev" type="button" disabled>← 上一页</button>
              <button class="pager-btn" id="pgNext" type="button" disabled>下一页 →</button>
            </div>
          </div>
        </div>

        <!-- 右侧：排序位 + 选中详情 -->
        <aside class="gal-side" aria-label="排序位与选中详情">
          <div class="slot-panel">
            <div class="sp-h"><span>SLOT MAP / 前九位</span><span class="sp-tag" id="spTag">—</span></div>
            <h2 class="sp-title">排序位<span class="dot">。</span></h2>
            <p class="sp-sub">数字即 position，1 最靠前 · 只看本页</p>

            <div class="slot-map" id="slotMap" aria-label="排序位示意"></div>

            <div class="sp-legend">
              <span>已占用 <b id="occCount">0</b> / 9</span>
              <span>空位 <b id="emptyCount">9</b></span>
            </div>

            <p class="sp-note">点格子可定位藏品。position 在编辑表单里改；新增的藏品默认不上架，补好展签再开灯。</p>
          </div>

          <div class="sel-panel">
            <span class="sel-k">选中 / SELECTED</span>
            <div class="sel-row"><span class="sel-no" id="selNo">—</span><span class="g-st" id="selSt"><i aria-hidden="true"></i>—</span></div>
            <h2 class="sel-name" id="selName">未选择</h2>
            <p class="sel-meta" id="selMeta">从左侧点一件藏品。</p>
            <div class="sel-acts">
              <button class="g-act" id="btnEditSel" type="button" disabled>编辑</button>
              <button class="g-act" id="btnToggleSel" type="button" disabled>上架</button>
              <button class="g-act" id="btnDelSel" type="button" disabled>删除</button>
            </div>
          </div>

          <p class="gal-note"><b>注意</b> 删除会同时删掉 D1 里的这一行，前台展柜立刻撤下；操作前会二次确认。媒体 key 为空时前台显示「未拍摄」占位。</p>

          <div class="recent-panel">
            <div class="sp-h"><span>RECENT / 最近入藏</span><span class="sp-tag">TOP 3</span></div>
            <div class="recent-list" id="recentList"></div>
          </div>
        </aside>
      </div>
    </section>

  </div>

<!-- ---------- 新增 / 编辑弹层 ---------- -->
<dialog class="dlg" id="editDlg" aria-labelledby="editDlgTitle">
  <div class="dlg-box">
    <span class="dlg-tab" id="editDlgTab">NEW</span>
    <div class="dlg-h"><span id="editDlgTitle">新增藏品</span><span>GALLERY / D1</span></div>

    <form id="editForm" novalidate>
      <div class="gf-grid">
        <label class="gfld"><span>编号 / NO <b>*</b></span>
          <input id="fNo" name="no" type="text" maxlength="20" autocomplete="off" spellcheck="false" placeholder="C-001">
        </label>
        <label class="gfld"><span>名称 / NAME <b>*</b></span>
          <input id="fName" name="name" type="text" maxlength="120" autocomplete="off" placeholder="鬼之根付">
        </label>
        <label class="gfld"><span>分类 / CATEGORY <b>*</b></span>
          <input id="fCat" name="category" type="text" maxlength="40" list="catList" autocomplete="off" placeholder="手办">
          <datalist id="catList"></datalist>
        </label>
        <label class="gfld"><span>年代 / ERA</span>
          <input id="fEra" name="era" type="text" maxlength="40" autocomplete="off" placeholder="明治 / 19 世纪">
        </label>
        <label class="gfld"><span>排序 / POSITION</span>
          <input id="fPos" name="position" type="number" min="0" max="9999" step="1" value="0">
        </label>
        <label class="gfld"><span>媒体 key / MEDIA</span>
          <input id="fMedia" name="mediaKey" type="text" maxlength="300" autocomplete="off" spellcheck="false" placeholder="gallery/k7-demon.jpg">
        </label>
        <label class="gfld gfld--wide"><span>展签 / NOTE</span>
          <textarea id="fNote" name="note" maxlength="400" rows="3" placeholder="一句为什么留着它。"></textarea>
        </label>
        <label class="gf-check gfld--wide"><input id="fDisplayed" type="checkbox"><span>直接上架（displayed）：勾选后立刻出现在前台展柜</span></label>
      </div>

      <p class="gf-err" id="editErr" hidden></p>

      <div class="gf-preview" id="editPreview" hidden>
        <img id="editPreviewImg" alt="媒体预览">
        <span id="editPreviewText"></span>
      </div>

      <div class="gf-f">
        <span class="dlg-c" id="editMode">POST /api/v1/admin/gallery</span>
        <div class="dlg-a">
          <button class="p-btn" id="editCancel" type="button">取消</button>
          <button class="p-btn p-btn--pub" id="editSubmit" type="submit">保存</button>
        </div>
      </div>
    </form>
  </div>
</dialog>

<!-- ---------- 删除确认 ---------- -->
<dialog class="dlg" id="delDlg" aria-labelledby="delDlgTitle">
  <div class="dlg-box">
    <span class="dlg-tab">DANGER</span>
    <div class="dlg-h"><span id="delDlgTitle">确认删除</span><span>DELETE / D1</span></div>
    <p class="cfm-p" id="delDlgText">删除后不可恢复。</p>
    <div class="dlg-f">
      <span class="dlg-c">此操作会立即影响前台展柜</span>
      <div class="dlg-a">
        <button class="p-btn" id="delCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub del-ok" id="delOk" type="button">删除</button>
      </div>
    </div>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline src="/js/pages/admin-gallery.js"></script>
</AdminLayout>
