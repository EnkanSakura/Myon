---
// 迁移自 design 分支 design/site/admin.html
// 样式：public(无)；脚本：public/js/pages/admin.js
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import type { SiteStats } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

// 总览只做统计：内容数量走 /api/v1/stats。
const statsRes = await app.request(
  '/api/v1/stats',
  {},
  env as unknown as AppBindings,
);
const stats: SiteStats | null = statsRes.ok
  ? ((await statsRes.json()) as SiteStats)
  : null;

const posts = stats?.posts ?? { published: 0, draft: 0, words: 0 };
const moments = stats?.moments ?? { total: 0 };
const gallery = stats?.gallery ?? { total: 0, displayed: 0, categories: [] };
const bangumi = stats?.bangumi ?? { total: 0, watching: 0 };
const media = stats?.media ?? { total: 0 };
const categories = stats?.categories ?? { posts: [], moments: [] };
