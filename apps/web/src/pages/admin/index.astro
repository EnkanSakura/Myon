---
// 后台总览：内容指标与访问曲线来自 /api/v1/stats、/api/v1/traffic（进程内取数）。
// 样式：public/css/admin.css；脚本：public/js/pages/admin.js
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import type { SiteStats, TrafficDay, TrafficSummary } from '@myon/shared';
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

const bindings = env as unknown as AppBindings;

// 维护模式是真实开关：初始状态来自站点设置，切换写回后台设置接口。
const settingsApi = `${apiBasePath}/admin/settings`;
const maintenanceEnabled = Astro.locals.site?.maintenanceEnabled ?? false;

/** 单个接口失败不该带崩整页：返回 null，渲染时降级成 0 值 / —。 */
async function readApi<T>(path: string): Promise<T | null> {
  try {
    const response = await app.request(path, {}, bindings);
    if (!response.ok) {
      console.error(`读取 ${path} 失败：HTTP ${response.status}`);
      return null;
    }
    return (await response.json()) as T;
  } catch (error) {
    console.error(`读取 ${path} 失败`, error);
    return null;
  }
}

const [stats, traffic] = await Promise.all([
  readApi<SiteStats>(`${apiBasePath}/stats`),
  readApi<TrafficSummary>(`${apiBasePath}/traffic`),
]);

/* ---------------- 内容计数 ---------------- */
const posts = stats?.posts ?? { published: 0, draft: 0, words: 0 };
const moments = stats?.moments ?? { total: 0 };
const gallery = stats?.gallery ?? { total: 0, displayed: 0, categories: [] };
const bangumi = stats?.bangumi ?? { total: 0, watching: 0 };
const categories = stats?.categories ?? { posts: [], moments: [] };

/* ---------------- 日期：Asia/Shanghai = UTC+8，无夏令时 ---------------- */
const weekdays = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
const SHANGHAI_OFFSET = 8 * 60 * 60 * 1000;

/** 把 UTC 时刻换算成北京时间的年月日时分与周几（0 = 周日）。 */
function shanghaiParts(date: Date) {
  const shifted = new Date(date.getTime() + SHANGHAI_OFFSET);
  return {
    year: shifted.getUTCFullYear(),
    month: shifted.getUTCMonth() + 1,
    day: shifted.getUTCDate(),
    hour: shifted.getUTCHours(),
    minute: shifted.getUTCMinutes(),
    weekday: shifted.getUTCDay(),
  };
}

const pad2 = (value: number) => String(value).padStart(2, '0');

/** 2026-10-20T01:12:00.000Z → 2026.10.20 09:12；取不到就显示 —。 */
function formatStamp(value: string | null | undefined): string {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  const parts = shanghaiParts(date);
  return `${parts.year}.${pad2(parts.month)}.${pad2(parts.day)} ${pad2(parts.hour)}:${pad2(parts.minute)}`;
}

const pageToday = shanghaiParts(new Date());
const headerDate = `${pageToday.year} 年 ${pageToday.month} 月 ${pageToday.day} 日`;
const headerWeekday = weekdays[(pageToday.weekday + 6) % 7];
const lastUpdatedText = formatStamp(stats?.lastUpdated);

/* ---------------- 访问曲线 ---------------- */
const PLOT = { left: 54, right: 1106, top: 12, bottom: 190 };
const PLOT_HEIGHT = PLOT.bottom - PLOT.top;

const num = (value: number) => value.toLocaleString('en-US');
const round1 = (value: number) => Math.round(value * 10) / 10;

/** 接口取不到时的兜底：30 个全 0 的天，保证曲线结构完整。 */
function emptyTraffic(): TrafficSummary {
  const end = new Date();
  const fallbackDays: TrafficDay[] = [];
  for (let index = 29; index >= 0; index -= 1) {
    const date = new Date(end.getTime() - index * 86_400_000);
    fallbackDays.push({ date: date.toISOString().slice(0, 10), pv: 0, uv: 0 });
  }
  return {
    days: fallbackDays,
    totals: { pv: 0, uv: 0 },
    today: fallbackDays[fallbackDays.length - 1],
  };
}

const fallbackTraffic = emptyTraffic();
const track = traffic && traffic.days.length > 0 ? traffic : fallbackTraffic;
const days = track.days;
const totals = track.totals;
const todayDay = days[days.length - 1];

const dayCount = days.length;
const stepX = (PLOT.right - PLOT.left) / Math.max(1, dayCount - 1);
const hitWidth = round1(stepX);

/** 纵轴刻度取 1 / 2 / 5 × 10^k，四个区间，标签一律是整数。 */
function niceStep(value: number): number {
  if (!(value > 0)) return 1;
  const base = 10 ** Math.floor(Math.log10(value));
  const unit = value / base;
  for (const candidate of [1, 2, 2.5, 5, 10]) {
    if (unit <= candidate) {
      const step = round1(candidate * base);
      return step >= 1 && Number.isInteger(step)
        ? step
        : Math.max(1, Math.ceil(step));
    }
  }
  return Math.ceil(value);
}

const peakPv = days.reduce((max, day) => Math.max(max, day.pv), 0);
// 全 0 时给一条 0–20 的空坐标，曲线贴着基线，不会算出 NaN。
const stepY = peakPv > 0 ? niceStep(peakPv / 4) : 5;
const yMax = stepY * 4;
const toY = (value: number) =>
  round1(
    PLOT.bottom - (Math.min(Math.max(value, 0), yMax) / yMax) * PLOT_HEIGHT,
  );

/** YYYY-MM-DD → 0 = 周一 … 6 = 周日（tooltip 用 data-w 取）。 */
function weekdayOf(date: string): number {
  const time = Date.parse(`${date}T00:00:00Z`);
  if (Number.isNaN(time)) return 0;
  return (new Date(time).getUTCDay() + 6) % 7;
}

const points = days.map((day, index) => {
  const x = round1(PLOT.left + index * stepX);
  return {
    date: day.date,
    x,
    pv: day.pv,
    uv: day.uv,
    pvY: toY(day.pv),
    uvY: toY(day.uv),
    weekday: weekdayOf(day.date),
    label: day.date.slice(5).replace('-', '.'),
    hitX: round1(x - stepX / 2),
  };
});
const lastPoint = points[points.length - 1];

const linePath = (key: 'pvY' | 'uvY') =>
  points
    .map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x},${point[key]}`)
    .join(' ');

const pvPath = linePath('pvY');
const uvPath = linePath('uvY');
const washPath = `M${PLOT.left},${PLOT.bottom} ${points
  .map((point) => `L${point.x},${point.pvY}`)
  .join(' ')} L${lastPoint.x},${PLOT.bottom} Z`;

// 网格 + 纵轴：4 段等分，最后一条是基线
const gridLines = [0, 1, 2, 3, 4].map((index) => ({
  y: round1(PLOT.top + (PLOT_HEIGHT / 4) * index),
  label: num(yMax - stepY * index),
  base: index === 4,
}));

// 横轴 5 个标签：首日、三等分点、今日
const xLabelIndexes = [
  ...new Set([
    0,
    Math.floor((dayCount - 1) / 4),
    Math.floor((dayCount - 1) / 2),
    Math.floor(((dayCount - 1) * 3) / 4),
    dayCount - 1,
  ]),
];
const xLabels = xLabelIndexes.map((index, order) => ({
  x: points[index].x,
  text: points[index].label,
  anchor:
    order === 0
      ? 'start'
      : order === xLabelIndexes.length - 1
        ? 'end'
        : 'middle',
  today: order === xLabelIndexes.length - 1,
}));

// 今日贴纸：默认贴在点的上方，顶部放不下时改到下方
const CARD_W = 112;
const CARD_H = 46;
const CARD_X = PLOT.right - 118;
const cardY =
  lastPoint.pvY - CARD_H - 10 >= PLOT.top
    ? lastPoint.pvY - CARD_H - 10
    : lastPoint.pvY + 10;

const peakIndex = days.reduce(
  (best, day, index) => (day.pv > days[best].pv ? index : best),
  0,
);
const peakDay = days[peakIndex];
const peakText =
  peakPv > 0
    ? `峰值 ${num(peakPv)} · ${peakDay.date.slice(5).replace('-', '.')} · ${
        weekdays[weekdayOf(peakDay.date)]
      }`
    : '峰值 0 · 暂无访问';

const compactMd = (date: string) =>
  `${Number(date.slice(5, 7))}.${date.slice(8, 10)}`;
const monthDay = (date: string) =>
  `${Number(date.slice(5, 7))} 月 ${Number(date.slice(8, 10))} 日`;

const chartDesc = `${monthDay(days[0].date)} 至 ${monthDay(lastPoint.date)}，PV 合计 ${num(
  totals.pv,
)}，UV 合计 ${num(totals.uv)}；今日进行中，累计 ${num(todayDay.pv)} PV。`;
---

<AdminLayout
  title="总览"
  crumb="总览"
  active="overview"
>
<div class="page" data-settings-api={settingsApi} data-maintenance={maintenanceEnabled ? 'true' : 'false'}>

    <!-- ---------- 页头 + 维护模式 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">08</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CONSOLE · 08</span>
          <span class="sticker sticker--paper">本日进行</span>
        </div>
        <h1>总览<span class="dot">。</span></h1>
        <p class="pdate">{headerDate} <span class="sep">·</span> {headerWeekday} <span class="sep">·</span> 最后更新 {lastUpdatedText}</p>
      </div>

      <div class="ph-r">
        <div class="lamp" id="maintLamp" data-on={maintenanceEnabled ? 'false' : 'true'}>
          <span class="lamp-tab">MAINTENANCE</span>
          <span class="lamp-sq" aria-hidden="true"></span>
          <span class="lamp-txt">
            <span class="lamp-k">维护模式 / MAINTENANCE</span>
            <span class="lamp-v" id="maintV">{maintenanceEnabled ? '维护中 · 访客看到维护页' : '营业中 · 访客可访问'}</span>
          </span>
          <button
            class="switch"
            id="maintSwitch"
            type="button"
            role="switch"
            aria-checked={maintenanceEnabled ? 'false' : 'true'}
            aria-label="维护模式"
            data-on={maintenanceEnabled ? 'false' : 'true'}
          >
            <span class="track"><span class="knob"></span></span>
          </button>
        </div>

        <div class="acts">
          <a class="btn btn--pink" href="/admin/articles">写文章 <span class="ar" aria-hidden="true">＋</span></a>
          <a class="btn" href="/admin/moments">发动态</a>
          <a class="btn" href="/admin/media">上传图片</a>
        </div>
      </div>
    </header>

    <!-- ---------- 指标 ---------- -->
    <section class="metrics" aria-label="站点指标">
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>文章 / ARTICLES</div>
        <div class="m-v">{posts.published}</div>
        <div class="m-f">已发布 <span class="msep">·</span>草稿 {posts.draft}</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>动态 / NOTES</div>
        <div class="m-v">{moments.total}</div>
        <div class="m-f"><span class="msep">·</span>{categories.moments.length} 个分类</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>展柜 / CABINET</div>
        <div class="m-v">{gallery.total}</div>
        <div class="m-f">展示中 {gallery.displayed} <span class="msep">·</span>{gallery.categories.length} 个分类</div>
      </div>
      <div class="metric">
        <div class="m-k"><i aria-hidden="true"></i>追番 / BANGUMI</div>
        <div class="m-v">{bangumi.total}</div>
        <div class="m-f">在追 {bangumi.watching} <span class="msep">·</span>共 {bangumi.total} 部</div>
      </div>
    </section>

    <!-- ---------- 01 访问 ---------- -->
    <section class="sec" id="traffic" aria-labelledby="h-traffic">
      <div class="sec-h">
        <span class="sec-num">01</span>
        <h2 id="h-traffic">访问</h2>
        <span class="sec-en">TRAFFIC / 30D</span>
        <div class="sec-r">
          <span class="legend"><i class="pv" aria-hidden="true"></i><span class="l-k">PV</span><b class="l-v">{num(totals.pv)}</b></span>
          <span class="legend"><i class="uv" aria-hidden="true"></i><span class="l-k">UV</span><b class="l-v">{num(totals.uv)}</b></span>
          <span class="sec-note">近 {dayCount} 天 · 只统计前台页面打开</span>
        </div>
      </div>

      <div class="chart-panel" id="chart">
        <svg class="chart-svg" viewBox="0 0 1120 236" role="img" aria-labelledby="chartTitle chartDesc">
          <title id="chartTitle">近 {dayCount} 天访问曲线</title>
          <desc id="chartDesc">{chartDesc}</desc>
          <defs>
            <pattern id="tone" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(20)">
              <circle class="tone-dot" cx="1.8" cy="1.8" r="1" fill-opacity=".42"></circle>
            </pattern>
          </defs>

          <g aria-hidden="true">
            {gridLines.map((line) => (
              <line class:list={['gl', { 'gl--base': line.base }]} x1={PLOT.left} y1={line.y} x2={PLOT.right} y2={line.y}></line>
            ))}
            {gridLines.map((line) => (
              <text class="ylab" x="42" y={line.y} dy=".32em" text-anchor="end">{line.label}</text>
            ))}

            <path class="wash" d={washPath}></path>
            <path class="area" d={washPath}></path>
            <path class="uvline" d={uvPath}></path>
            <path class="pvline" d={pvPath}></path>

            <line class="today-guide" x1={PLOT.right} y1={lastPoint.pvY} x2={PLOT.right} y2={PLOT.bottom}></line>
            <circle class="today-halo" cx={lastPoint.x} cy={lastPoint.pvY} r="9"></circle>
            <circle class="today-dot" cx={lastPoint.x} cy={lastPoint.pvY} r="4"></circle>

            <rect class="co-shadow" x={CARD_X + 4} y={cardY + 4} width={CARD_W} height={CARD_H}></rect>
            <rect class="co-card" x={CARD_X} y={cardY} width={CARD_W} height={CARD_H}></rect>
            <text class="co-k" x={CARD_X + 10} y={cardY + 18}>今日进行中</text>
            <text class="co-v" x={CARD_X + 10} y={cardY + 37}>{`${num(todayDay.pv)} PV`}</text>
            <path class="co-lead" d={`M${CARD_X + CARD_W},${round1(cardY + CARD_H * 0.65)} L${round1(PLOT.right - 2)},${round1(lastPoint.pvY - 3)}`}></path>

            <g>
              {points.map((point, index) => (
                <line class="tk" x1={point.x} y1={PLOT.bottom} x2={point.x} y2={index === 0 || index === dayCount - 1 ? 195 : 194}></line>
              ))}
            </g>

            {xLabels.map((label) => (
              <text class:list={['xlab', { 'is-today': label.today }]} x={label.x} y="222" text-anchor={label.anchor}>{label.text}</text>
            ))}
          </g>

          <g class="hits">
            {points.map((point, index) => (
              <rect
                class="hit"
                x={point.hitX}
                y={PLOT.top}
                width={hitWidth}
                height={PLOT_HEIGHT}
                data-i={index}
                data-d={point.label}
                data-pv={point.pv}
                data-uv={point.uv}
                data-x={point.x}
                data-y={point.pvY}
                data-w={point.weekday}
              ></rect>
            ))}
          </g>

          <line id="hGuide" class="hguide" x1="0" y1="12" x2="0" y2="190" opacity="0"></line>
          <circle id="hDot" class="hdot" cx="0" cy="0" r="4" opacity="0"></circle>
        </svg>

        <div class="tip" id="tip" hidden>
          <div class="tip-k" id="tipDate">—</div>
          <div class="tip-v"><span class="tk-l">PV</span><b id="tipPv">—</b><span class="tk-s">/</span><span class="tk-l">UV</span><b id="tipUv">—</b></div>
        </div>
      </div>

      <div class="chart-mark">
        <span>{compactMd(days[0].date)} – {compactMd(lastPoint.date)} / {dayCount} 天</span>
        <span>{peakText}</span>
        <span>今日 {num(todayDay.pv)} PV · {num(todayDay.uv)} UV</span>
      </div>
    </section>

  </div>

  <script is:inline src="/js/pages/admin.js"></script>
</AdminLayout>
