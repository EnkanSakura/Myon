---
// 后台 · 关于 / README：读取 GET /api/v1/about，保存 PUT /api/v1/admin/about。
// 样式：public/css/pages/admin-about.css；脚本：public/js/pages/admin-about.js
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';

const aboutReadApi = `${apiBasePath}/about`;
const aboutApi = `${apiBasePath}/admin/about`;
---

<AdminLayout
  title="关于 / README"
  crumb="关于 · README"
  active="about"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/admin-about.css" />
  </Fragment>

  <div class="page" data-api={aboutApi} data-read-api={aboutReadApi}>

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">CONSOLE · README</span>
          <span class="sticker sticker--paper">关于页</span>
        </div>
        <h1>关于 / README<span class="dot">。</span></h1>
        <p class="pdate">首页封面叠放展示 <span class="sep">·</span> 支持 Markdown</p>
      </div>

      <div class="ph-r">
        <div class="acts">
          <button class="btn" id="reloadBtn" type="button">重新读取</button>
          <button class="btn btn--pink" id="saveBtn" type="button" disabled>保存</button>
        </div>
        <p class="ph-note" id="saveState" role="status" aria-live="polite">读取中…</p>
      </div>
    </header>

    <!-- ---------- 唯一的页面级提示 ---------- -->
    <div class="notice notice--info" id="abBanner" role="status" hidden>
      <span class="notice-k" id="abBannerK">INFO</span>
      <div class="notice-c">
        <b id="abBannerTitle"></b>
        <p id="abBannerText"></p>
      </div>
      <button class="notice-btn" id="abToken" type="button" data-token-open hidden>管理令牌</button>
      <button class="notice-btn" id="abRetry" type="button" hidden>重试</button>
    </div>

    <!-- ---------- 编辑器 + 预览 ---------- -->
    <div class="ab-grid">
      <section class="ab-panel" aria-labelledby="ab-editor">
        <div class="ab-head">
          <span class="sec-num">01</span>
          <h2 id="ab-editor">编辑器</h2>
          <span class="ab-en">MARKDOWN</span>
          <span class="ab-file">README.md</span>
        </div>
        <div class="ab-body ab-body--editor">
          <label class="sr-only" for="mdInput">README Markdown 内容</label>
          <textarea class="md-input" id="mdInput" spellcheck="false" disabled placeholder="# 关于 Myon&#10;&#10;在这里写一段关于自己的话。"></textarea>
        </div>
        <div class="ab-foot">
          <span>标题 / 列表 / 引用 / 粗斜体 / 行内代码 / 链接</span>
          <span id="mdCounts">—</span>
        </div>
      </section>

      <section class="ab-panel" aria-labelledby="ab-preview">
        <div class="ab-head">
          <span class="sec-num">02</span>
          <h2 id="ab-preview">预览</h2>
          <span class="ab-en">LIVE</span>
          <span class="ab-file">首页 01 封面 · 纸卡</span>
        </div>
        <div class="ab-body ab-body--preview">
          <aside class="about-card" aria-label="首页关于卡预览">
            <div class="ah"><span>README.md · 关于</span></div>
            <div class="about-body" id="mdPreview"></div>
          </aside>
        </div>
        <div class="ab-foot">
          <span>预览是本地渲染，保存后前台才会更新</span>
          <span id="sourceTag">来源：读取中…</span>
        </div>
      </section>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline src="/js/markdown.js"></script>
  <script is:inline src="/js/pages/admin-about.js"></script>
</AdminLayout>
