---
// 迁移自 design 分支 design/site/admin-moments.html。
// 2026-10 改版：页面只保留列表；新增 / 编辑改走呼出对话框（<dialog id="momentDlg">），
// 配图由共享媒体选择器（public/js/media-picker.js）返回 MediaItem。
// 数据走 /api/v1/admin/moments（需要 x-admin-token，令牌存在浏览器 localStorage）。
// 样式：public/css/pages/admin-moments.css；脚本：public/js/pages/admin-moments.js
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import type { CategoriesResponse } from '@myon/shared';
import { apiBasePath } from '@myon/shared';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mediaUrl } from '../../lib/media';

const binding = env as unknown as AppBindings;

// 接口地址由服务端渲染给页面脚本，public/js 里不硬编码路径。
const momentsApi = `${apiBasePath}/admin/moments`;
const mediaApi = `${apiBasePath}/admin/media`;
const gifWebpApi = `${mediaApi}/gif-webp`;

// 分类建议来自公开的分类计数（/categories 不需要令牌）；取不到就用一组默认值。
let momentCategories: string[] = [];
try {
  const categoriesRes = await app.request('/api/v1/categories', {}, binding);
  if (categoriesRes.ok) {
    const data = (await categoriesRes.json()) as CategoriesResponse;
    momentCategories = data.moments.map((entry) => entry.name);
  }
} catch (error) {
  console.error('后台动态页读取分类失败', error);
}
const categoryOptions =
  momentCategories.length > 0
    ? momentCategories
    : ['日常', '技术', '收藏', '看番', '碎念'];
const defaultCategory = categoryOptions.includes('日常')
  ? '日常'
  : (categoryOptions[0] ?? '日常');

// 图片预览的 URL 规则来自 mediaUrl()，脚本只负责把 key 拼回去。
const mediaSample = mediaUrl('__KEY__');
const mediaBase = mediaSample ? mediaSample.replace('__KEY__', '') : '';
---

<AdminLayout
  title="动态"
  crumb="动态"
  active="moments"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/admin-moments.css" />
  </Fragment>

<div class="page" data-api-moments={momentsApi} data-api-media={mediaApi} data-gif-api={gifWebpApi} data-media-base={mediaBase}>

    <!-- ---------- 页头 ---------- -->
    <header class="phead">
      <span class="chapter" aria-hidden="true">N.03</span>

      <div class="ph-l">
        <div class="kicker">
          <span class="sticker">NOTES / ADMIN</span>
          <span class="sticker sticker--paper">共 <span id="stickerPub">—</span> 条</span>
        </div>
        <h1>动态<span class="dot">。</span></h1>
        <p class="pdate">今天 <span id="noteToday">—</span> 条 <span class="sep">·</span> 最后发布 <span id="noteLast">—</span></p>
      </div>

      <div class="ph-r">
        <div class="acts">
          <button class="btn btn--pink" id="btnCompose" type="button">发动态 <span class="ar" aria-hidden="true">＋</span></button>
          <a class="btn" href="/moments">看前台动态 <span class="ar" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>

    <!-- ---------- 唯一的页面级提示 ---------- -->
    <div class="notice notice--info" id="amBanner" role="status" hidden>
      <span class="notice-k" id="amBannerK">INFO</span>
      <div class="notice-c">
        <b id="amBannerTitle"></b>
        <p id="amBannerText"></p>
      </div>
      <button class="notice-btn" id="btnToken" type="button" data-token-open>管理令牌</button>
    </div>

    <!-- ---------- 01 列表 ---------- -->
    <section class="sec" aria-labelledby="h-list">
      <div class="sec-h">
        <span class="sec-num">01</span>
        <h2 id="h-list">列表</h2>
        <span class="sec-en" id="notesEn">NOTES / —</span>
        <div class="sec-r">
          <span class="sec-note" id="listState" aria-live="polite">未连接</span>
          <a class="arrow-link" href="/moments">前台四格 <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="filterbar" aria-label="筛选动态">
        <div class="fb-chips" role="group" aria-label="按分类筛选">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">全部</button>
          {categoryOptions.map((name) => (
            <button class="chip" type="button" data-filter={name} aria-pressed="false">{name}</button>
          ))}
        </div>

        <button class="fb-toggle" id="imgToggle" type="button" aria-pressed="false">带图</button>

        <label class="fb-search">
          <span class="sr-only">搜索动态</span>
          <input id="noteSearch" type="search" placeholder="搜正文、分类或标签" autocomplete="off">
        </label>

        <span class="fb-count" id="shownNotes" aria-live="polite">显示 — 条 · 筛选只作用于本页</span>
        <button class="fb-clear" id="clearFilters" type="button">清除</button>
      </div>

      <div class="notes" id="noteList">
        <div class="note-head" aria-hidden="true">
          <span>时间</span><span>内容</span><span class="hd-thumb">图</span><span class="hd-tag">分类 · 标签</span><span class="hd-r">操作</span>
        </div>
        <!-- 列表行由 public/js/pages/admin-moments.js 按接口数据渲染 -->
      </div>

      <div class="empty" id="emptyNotes" hidden>
        <div class="empty-c">
          <b class="empty-t" id="emptyTitle">还没有动态</b>
          <p class="empty-d" id="emptyText">点右上角「发动态」写第一条，或者填写管理令牌后刷新列表。</p>
        </div>
        <div class="empty-actions"><button class="nr-act" id="btnResetFilter" type="button">清除筛选</button></div>
      </div>

      <div class="pager">
        <span class="pager-info">第 <b id="pgNow">—</b> / <b id="pgTotal">—</b> 页 · 每页 20 条</span>
        <div class="pager-btns">
          <button class="pager-btn" id="pgPrev" type="button" disabled>← 上一页</button>
          <button class="pager-btn" id="pgNext" type="button" disabled>下一页 →</button>
        </div>
      </div>
    </section>

  </div>

<!-- ---------- 发 / 编辑动态（呼出对话框） ---------- -->
<dialog class="dlg moment-dlg" id="momentDlg" aria-labelledby="momentDlgTitle">
  <form class="dlg-box moment-box" id="momentForm" novalidate>
    <span class="dlg-tab">NOTE / 动态</span>

    <div class="dlg-h">
      <span id="momentDlgTitle">发动态</span>
      <span id="momentDlgState" aria-live="polite">未发布</span>
    </div>

    <div class="moment-banner" id="momentBanner" role="status" hidden>
      <span class="moment-banner-k" id="momentBannerK">ERR</span>
      <div class="moment-banner-c">
        <b id="momentBannerTitle"></b>
        <p id="momentBannerText"></p>
        <ul class="moment-issues" id="momentIssues" hidden></ul>
      </div>
    </div>

    <div class="moment-field moment-field--wide">
      <label for="noteText">正文 / TEXT</label>
      <textarea class="dlg-note" id="noteText" rows="5" maxlength="2000" spellcheck="false" placeholder="现在在做什么…"></textarea>
      <p class="moment-count">
        <span>纯文本动态，不支持 Markdown</span>
        <span><b id="noteCount">0</b> / 2000</span>
      </p>
    </div>

    <div class="moment-field moment-field--wide">
      <span class="moment-label">配图 / IMAGE</span>
      <div class="moment-media">
        <button class="moment-act" id="btnPickImage" type="button">选择图片 <span aria-hidden="true">＋</span></button>
        <div class="moment-attach" id="attachBox">
          <img id="attachImg" alt="已选配图">
          <span class="moment-attach-name" id="attachName">未选图</span>
          <button class="moment-act" id="btnRemoveImg" type="button">移除</button>
        </div>
      </div>
    </div>

    <div class="moment-fields">
      <div class="moment-field">
        <label for="noteCategory">分类 / CATEGORY</label>
        <input class="moment-input" id="noteCategory" name="category" type="text" maxlength="40" list="categoryList" placeholder="日常" autocomplete="off" value={defaultCategory}>
        <datalist id="categoryList">
          {categoryOptions.map((name) => <option value={name} />)}
        </datalist>
      </div>

      <div class="moment-field">
        <label for="noteTag">标签 / TAG</label>
        <input class="moment-input" id="noteTag" name="tag" type="text" maxlength="40" placeholder="可留空" autocomplete="off">
        <div class="moment-tags" id="tagQuick">
          {categoryOptions.map((name) => (
            <button class="moment-tag" type="button" data-tag={name} aria-pressed="false">{name}</button>
          ))}
        </div>
      </div>

      <div class="moment-field">
        <span class="moment-label">可见性 / VISIBILITY</span>
        <div class="moment-tags" id="visPick">
          <button class="moment-tag" type="button" data-vis="public" aria-pressed="true">公开</button>
          <button class="moment-tag" type="button" data-vis="private" aria-pressed="false">仅自己</button>
        </div>
      </div>

      <div class="moment-field">
        <span class="moment-label">置顶 / PINNED</span>
        <div class="moment-tags">
          <button class="moment-tag" id="pinPick" type="button" aria-pressed="false">置顶这条</button>
        </div>
      </div>
    </div>

    <div class="moment-foot">
      <span class="moment-meta">发布后同步前台第 03 页；「仅自己」的动态不进前台列表与 RSS。</span>
      <div class="moment-actions">
        <button class="p-btn" id="btnCancelMoment" type="button">取消</button>
        <button class="p-btn p-btn--pub" id="btnPublish" type="submit">发布</button>
      </div>
    </div>
  </form>
</dialog>

<!-- ---------- 删除确认 ---------- -->
<dialog class="dlg" id="confirmDlg" aria-labelledby="confirmTitle">
  <div class="dlg-box">
    <span class="dlg-tab">CONFIRM / 二次确认</span>
    <div class="dlg-h"><span id="confirmTitle">删除这条动态？</span><span>DELETE</span></div>
    <p class="dlg-c" id="confirmText">删除后前台立即消失，不能撤销。</p>
    <p class="dlg-c">将要删除：<b id="confirmMeta">—</b></p>
    <div class="dlg-f">
      <span class="dlg-c" id="confirmState" aria-live="polite"></span>
      <div class="dlg-a">
        <button class="p-btn" id="confirmCancel" type="button">取消</button>
        <button class="p-btn p-btn--pub" id="confirmOk" type="button">确认删除</button>
      </div>
    </div>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline src="/js/image-upload.js"></script>
  <script is:inline src="/js/media-picker.js"></script>
  <script is:inline src="/js/pages/admin-moments.js"></script>
</AdminLayout>
