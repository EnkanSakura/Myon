        <p>{homeTools.length} 个自己会用的东西，顺手放在部室的抽屉里。</p>
        <div class="open"><b>{String(homeTools.length).padStart(2, '0')}</b><span>个 / TOOLS</span></div>
        <a class="arrow-link" href="/tools" style="margin-top:12px">打开工具台 <span class="ar">→</span></a>
      </div>
      <div class="reveal" style="--i:1">
        {homeTools.length > 0 ? (
          <div class="drawers">
            {homeTools.slice(0, 8).map((tool, index) => (
