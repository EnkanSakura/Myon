  <!-- 06 工具：抽屉列表来自 D1，不再有调用次数 -->
  <section class="panel p6" data-room="工具" data-no="06" aria-label="第 6 页，工具">
    <div class="inner">
      <div class="head reveal" style="--i:0">
        <div class="kicker"><span class="sticker">{home.pages[5]}</span></div>
