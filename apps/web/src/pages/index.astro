                <span class="dno">{String(index + 1).padStart(2, '0')}</span>
                <span class="dn">{tool.name}</span>
                <span class="dd"><span>{tool.description || tool.kind || '打开工具'}</span><span>→</span></span>
              </a>
            ))}
            <a class="drawer drawer--more" href="/tools"><span class="dno">→</span><span class="dn">打开工具台</span><span class="dd"><span>ALL TOOLS</span><span>↗</span></span></a>
          </div>
        ) : (
          <div class="drawers">
            <a class="drawer is-open" href="/tools">
              <span class="dno">—</span>
              <span class="dn">工具还在整理</span>
              <span class="dd"><span>去后台登记后出现在这里</span><span>→</span></span>
            </a>
          </div>
        )}
        <div class="note"><span>{homeTools.length} 个工具 · 页面由 Workers 送达</span><span>换算在浏览器完成 · 不写入 D1</span></div>
      </div>
    </div>
  </section>

  <!-- 07 尾页 -->
  <section class="panel p7" data-room="尾页" data-no="07" aria-label="第 7 页，后记">
    <div class="inner">
      <div class="copy reveal" style="--i:0">
        <div class="label"><span class="sticker">{home.pages[6]}</span><span class="sticker sticker--paper">FIN</span></div>
        <h2>{end.title}<span class="hl">。</span></h2>
        <p class="after">{end.lead}</p>
        <div class="thank"><span class="t">{author.toUpperCase()}</span><span class="s">{site.subtitle} · © {year} {author}</span></div>
      </div>
      <div class="letter reveal" style="--i:2">
        <div class="lt"><span>AFTERWORD / 后记</span><span>P.07</span></div>
        <p>
          {afterwordLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
        </p>
        {end.afterword.sign && <div class="sign">{end.afterword.sign}</div>}
        {end.afterword.next && <span class="nextissue">{end.afterword.next}</span>}
      </div>
    </div>
  </section>
</div>

<div class="sheet" aria-hidden="true"><span class="pg" id="sheetPg">01</span></div>

<div class="scroll-cue" id="scrollCue" aria-hidden="true">本页还有内容 · 滚到底翻页 ↓</div>

<SiteBar settings={site}>
  <Fragment slot="left">
    <div class="pager" aria-label="翻页">
      <button data-go="0" aria-current="true">01</button>
      <button data-go="1">02</button>
      <button data-go="2">03</button>
      <button data-go="3">04</button>
      <button data-go="4">05</button>
      <button data-go="5">06</button>
      <button data-go="6">07</button>
    </div>
    <span class="hint"><span id="hintText">滚动 · 翻到下一页</span><span class="ln"></span></span>
  </Fragment>
</SiteBar>

<script is:inline>
(function(){
  var stage = document.getElementById('stage');
  var panels = Array.prototype.slice.call(document.querySelectorAll('.panel'));
  var pager = Array.prototype.slice.call(document.querySelectorAll('.pager button'));
  var pageSticker = document.getElementById('pageSticker');
  var sheetPg = document.getElementById('sheetPg');
  var hintText = document.getElementById('hintText');
  var cue = document.getElementById('scrollCue');
  var idx = 0, lock = false, wheelAcc = 0, wheelTimer = null;

  function paint(){
    panels.forEach(function(p, i){
      p.classList.toggle('is-active', i === idx);
      p.classList.toggle('is-above', i < idx);
      p.classList.toggle('is-below', i > idx);
      p.setAttribute('aria-hidden', i === idx ? 'false' : 'true');
      if(i === idx){ p.removeAttribute('inert'); } else { p.setAttribute('inert',''); }
    });
    pager.forEach(function(b, i){ b.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
    var no = ('0' + (idx + 1)).slice(-2);
    pageSticker.textContent = 'PAGE ' + no + ' / 07';
    if(sheetPg) sheetPg.textContent = no;
    if(hintText) hintText.textContent = hintFor();
    try { sessionStorage.setItem('myon-v2-panel', String(idx)); } catch(e){}
    if(location.hash !== '#p=' + idx){ try { history.replaceState(null, '', '#p=' + idx); } catch(e){} }
    updateCue();
  }

  function readPanel(){
    var m = /(?:^|[#&?])p=(\d+)/.exec(location.hash + '&' + location.search);
    if(m){ var n = parseInt(m[1], 10); if(!isNaN(n)) return Math.max(0, Math.min(panels.length - 1, n)); }
    try { var st = parseInt(sessionStorage.getItem('myon-v2-panel') || '', 10); if(!isNaN(st)) return Math.max(0, Math.min(panels.length - 1, st)); } catch(e){}
    return 0;
  }

  function activePanel(){ return panels[idx]; }
  function canScroll(p){ return !!p && p.scrollHeight - p.clientHeight > 8; }
  function atTop(p){ return !p || p.scrollTop <= 2; }
  function atBottom(p){ return !p || p.scrollTop + p.clientHeight >= p.scrollHeight - 2; }
  function hintFor(){
    var p = activePanel();
    if(canScroll(p) && !atBottom(p)) return '本页还有内容 · 滚到底翻页';
    return idx === panels.length - 1 ? '滚动 · 回到第一页' : '滚动 · 翻到下一页';
  }
  function updateCue(){
    var p = activePanel();
    var show = canScroll(p) && !atBottom(p);
    if(cue) cue.classList.toggle('is-on', show);
    if(hintText) hintText.textContent = hintFor();
  }
  function scrollPanelBy(p, dir){
    var step = Math.max(120, Math.round(p.clientHeight * 0.72));
    p.scrollBy({ top: dir * step, behavior: 'smooth' });
  }

  function bump(){
    stage.classList.remove('bump');
    void stage.offsetWidth;
    stage.classList.add('bump');
    setTimeout(function(){ stage.classList.remove('bump'); }, 320);
  }

  function go(n){
    if(lock) return;
    if(n < 0){ bump(); return; }
    if(n > panels.length - 1){ bump(); return; }
    if(n === idx) return;
    lock = true;
    idx = n;
    if(panels[idx]) panels[idx].scrollTop = 0;
    paint();
    // 淡入淡出：旧页在 .42s 内淡出，新页同时淡入，不再叠加主题色闪光
    setTimeout(function(){ lock = false; }, 460);
  }

  pager.forEach(function(b){ b.addEventListener('click', function(){ go(parseInt(b.getAttribute('data-go'), 10)); }); });

  window.addEventListener('wheel', function(e){
    var p = activePanel();
    var delta = e.deltaY;
    if(delta === 0) return;

    // 本页内容比一屏高时：先让面板自己滚，滚到底/顶再翻页
    if(canScroll(p)){
      var blocked = delta > 0 ? atBottom(p) : atTop(p);
      if(!blocked){ updateCue(); return; }
    }

    e.preventDefault();
    wheelAcc += delta;
    clearTimeout(wheelTimer);
    wheelTimer = setTimeout(function(){ wheelAcc = 0; }, 180);
    if(Math.abs(wheelAcc) < 24) return;
    var dir = wheelAcc > 0 ? 1 : -1;
    wheelAcc = 0;
    go(idx + dir);
  }, { passive: false });

  window.addEventListener('keydown', function(e){
    var down = e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ';
    var up = e.key === 'ArrowUp' || e.key === 'PageUp';
    if(down || up){
      e.preventDefault();
      var dir = down ? 1 : -1;
      var p = activePanel();
      if(canScroll(p)){
        var blocked = dir > 0 ? atBottom(p) : atTop(p);
        if(!blocked){ scrollPanelBy(p, dir); return; }
      }
      go(idx + dir);
      return;
    }
    if(e.key === 'Home'){ e.preventDefault(); go(0); }
    else if(e.key === 'End'){ e.preventDefault(); go(panels.length - 1); }
  });

  var touchY = null;
  window.addEventListener('touchstart', function(e){ touchY = e.touches[0].clientY; }, { passive: true });
  window.addEventListener('touchend', function(e){
    if(touchY === null) return;
    var p = activePanel();
    var dy = touchY - e.changedTouches[0].clientY;
    touchY = null;
    if(Math.abs(dy) <= 46) return;

    var dir = dy > 0 ? 1 : -1;
    if(canScroll(p)){
      var blocked = dir > 0 ? atBottom(p) : atTop(p);
      if(!blocked) return;
    }
    go(idx + dir);
  }, { passive: true });

  panels.forEach(function(p){ p.addEventListener('scroll', updateCue, { passive: true }); });
  window.addEventListener('resize', updateCue);

  document.getElementById('startBtn').addEventListener('click', function(){ go(1); });

  idx = readPanel();
  paint();
  if(idx > 0) try { history.replaceState(null, '', '#p=' + idx); } catch(e){}

  window.addEventListener('pageshow', function(e){
    if(e.persisted){ var n = readPanel(); if(n !== idx){ idx = n; paint(); } }
  });
  window.addEventListener('hashchange', function(){ var n = readPanel(); if(n !== idx){ idx = n; paint(); } });
})();
</script>
<script is:inline src="/js/markdown.js"></script>
<script is:inline src="/js/site.js" defer></script>
</body>
</html>
