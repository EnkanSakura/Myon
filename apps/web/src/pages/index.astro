---
// 首页：由设计稿迁移；数据接口在 /api/v1/*
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import { renderMarkdown } from '@myon/back/markdown';
import type { AppBindings } from '@myon/back/types';
import 'katex/dist/katex.min.css';
import {
  type BangumiShow,
  defaultSiteSettings,
  formatPageTitle,
  type GalleryItem,
  type HomeLink,
  type HomeStatPreset,
  type MomentListItem,
  type Paginated,
  type PostListItem,
  type SiteIcon,
  type SiteStats,
  type ToolListResponse,
  toPublicSiteSettings,
} from '@myon/shared';
import SiteBar from '../components/SiteBar.astro';
import ThemeTokens from '../components/ThemeTokens.astro';
import { defaultAboutMarkdown } from '../lib/about-default';
import { formatDate } from '../lib/format';
import { mediaUrl } from '../lib/media';

const site = Astro.locals.site ?? toPublicSiteSettings(defaultSiteSettings);
const home = site.home;
// 第 2 页右侧装饰框统一用后台「封面图」设置（详见 AGENTS 首页约定）；
// 第 3/4 页只展示真实条目自带的图片，条目为空时不渲染任何图片，改为空态提示。
const homeCoverImage = mediaUrl(home.cover.image);
const end = site.end;
const leadLines = home.lead.split(String.fromCharCode(10));
const afterwordLines = end.afterword.body.split(String.fromCharCode(10));
const author = site.author || site.name;
const year = String(new Date().getFullYear());

const bindings = env as unknown as AppBindings;

/** 首页各面板都走进程内 API；某个面板读取失败时只让该面板退回空态。 */
async function readHomeApi<T>(path: string): Promise<T | null> {
  try {
    const response = await app.request(path, {}, bindings);
    if (!response.ok) return null;
    return (await response.json()) as T;
  } catch (error) {
    console.error('[home] 读取失败', path, error);
    return null;
  }
}

// 联系方式配置的是 Iconify 名称，这里批量换成可内联的 SVG；取不到就退回内置线稿图标。
const iconNames = [
  ...new Set(
    home.links
      .map((link) => link.icon)
      .filter((icon): icon is string => typeof icon === 'string'),
  ),
];

// 一次并发取齐七页的数据，避免串行等待；只读公开接口，不新增 API 契约。
const [
  statsData,
  aboutData,
  postsData,
  toolsData,
  momentsData,
  galleryData,
  bangumiData,
  iconData,
] = await Promise.all([
  readHomeApi<SiteStats>('/api/v1/stats'),
  readHomeApi<{ html?: string }>('/api/v1/about'),
  readHomeApi<Paginated<PostListItem>>('/api/v1/posts?limit=3'),
  readHomeApi<ToolListResponse>('/api/v1/tools'),
  readHomeApi<Paginated<MomentListItem>>('/api/v1/moments?limit=4'),
  readHomeApi<Paginated<GalleryItem>>('/api/v1/gallery?limit=3'),
  // 第 5 页是动画放送：只取动画，limit 放到上限用于生成本周放送表。
  readHomeApi<Paginated<BangumiShow>>('/api/v1/bangumi?type=anime&limit=100'),
  iconNames.length > 0
    ? readHomeApi<{ icons: SiteIcon[] }>(
        `/api/v1/icons?names=${encodeURIComponent(iconNames.join(','))}`,
      )
    : Promise.resolve(null),
]);

const siteStats = statsData;
const publishedCount = siteStats?.posts.published ?? 0;

// 封面「关于」纸卡：直接用服务端渲染好的 HTML（与正文同一套 Markdown 渲染器），
// 不再由前端迷你渲染器二次解析，删除线/表格/代码块等格式才不会丢。
const aboutHtml =
  aboutData?.html?.trim() || renderMarkdown(defaultAboutMarkdown);

// 第 2 页：最近文章（按发布时间倒序，取最新 3 条）。
const latestPosts = postsData?.items ?? [];

// 第 3 页：最近动态（接口已按置顶 + 时间倒序，只返回公开动态）。
const latestMoments = momentsData?.items ?? [];
const momentsTotal = momentsData?.total ?? siteStats?.moments.total ?? 0;

// 第 4 页：展柜里已展示的藏品；没有图的条目不占图位。
const galleryCards = (galleryData?.items ?? [])
  .filter((item) => item.mediaKey)
  .slice(0, 3)
  .map((item) => ({ ...item, image: mediaUrl(item.mediaKey) ?? '' }));
const galleryTotal = siteStats?.gallery.displayed ?? galleryData?.total ?? 0;
const galleryCategories = siteStats?.gallery.categories ?? [];
const galleryCategoryRows = galleryCategories.slice(0, 4);
const galleryOtherCount = galleryCategories
  .slice(4)
  .reduce((sum, entry) => sum + entry.count, 0);

// 第 5 页：动画在追。nextAirAt 只有同步数据带回来时才显示放送信息，不自行推算。
const animeShows = (bangumiData?.items ?? []).filter(
  (item) => item.status === 'watching',
);
const animeWatchingCount =
  siteStats?.bangumi.byType.anime.watching ?? animeShows.length;
const bangumiWatchingCount = siteStats?.bangumi.watching ?? animeWatchingCount;
const watchedShows = animeShows
  .slice()
  .sort((a, b) => {
    // 有放送日期的排在前面（更有可能是正在更新的一季），其次按最近更新。
    if (!!a.nextAirAt !== !!b.nextAirAt) return a.nextAirAt ? -1 : 1;
    if (a.nextAirAt && b.nextAirAt) {
      return a.nextAirAt.localeCompare(b.nextAirAt);
    }
    return b.updatedAt.localeCompare(a.updatedAt);
  })
  .slice(0, 3);
const airingShows = animeShows.filter((item) => item.nextAirAt);

// 第 6 页：工具抽屉来自 D1（只取启用项），不再写死工具名与调用次数。
const homeTools = toolsData?.items ?? [];

const iconSvgs = new Map<string, string>();
for (const icon of iconData?.icons ?? []) iconSvgs.set(icon.name, icon.svg);

function formatLatest(value: string | null | undefined): string {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
  const day = String(date.getUTCDate()).padStart(2, '0');
  return `${month}.${day}`;
}

function formatWords(value: number): string {
  return value >= 10000 ? `${(value / 10000).toFixed(1)} 万` : String(value);
}

const SHANGHAI_OFFSET_MS = 8 * 60 * 60 * 1000;
const WEEKDAY_LABELS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];

function pad2(value: number): string {
  return String(value).padStart(2, '0');
}

/** 固定按 UTC+8 拆日期，不依赖运行时 Intl 时区数据。 */
function shanghaiParts(value: string) {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  const shifted = new Date(date.getTime() + SHANGHAI_OFFSET_MS);
  return {
    year: shifted.getUTCFullYear(),
    month: shifted.getUTCMonth() + 1,
    day: shifted.getUTCDate(),
    weekday: shifted.getUTCDay(),
    hour: shifted.getUTCHours(),
    minute: shifted.getUTCMinutes(),
  };
}

/** 动态面板的时间：刚刚 / N 分钟前 / 今天 / 昨天 / 周X / 完整日期。 */
function formatRelativeTime(value: string): string {
  const parts = shanghaiParts(value);
  if (!parts) return '—';
  const diffMinutes = Math.floor(
    (Date.now() - new Date(value).getTime()) / 60000,
  );
  if (diffMinutes < 1) return '刚刚';
  if (diffMinutes < 60) return `${diffMinutes} 分钟前`;
  const now = shanghaiParts(new Date().toISOString());
  if (!now) return `${parts.year}.${pad2(parts.month)}.${pad2(parts.day)}`;
  if (
    parts.year === now.year &&
    parts.month === now.month &&
    parts.day === now.day
  ) {
    return `今天 ${pad2(parts.hour)}:${pad2(parts.minute)}`;
  }
  const dayDiff = Math.round(
    (Date.UTC(now.year, now.month - 1, now.day) -
      Date.UTC(parts.year, parts.month - 1, parts.day)) /
      86400000,
  );
  if (dayDiff === 1) return `昨天 ${pad2(parts.hour)}:${pad2(parts.minute)}`;
  if (dayDiff > 1 && dayDiff <= 6) {
    return `${WEEKDAY_LABELS[parts.weekday]} ${pad2(parts.hour)}:${pad2(parts.minute)}`;
  }
  return `${parts.year}.${pad2(parts.month)}.${pad2(parts.day)}`;
}

/** 放送时间同步自 Bangumi 日历时只有「星期几」，当天 00:00（UTC+8）视为时刻未知。 */
function hasAirTime(value: string): boolean {
  const parts = shanghaiParts(value);
  return !!parts && (parts.hour !== 0 || parts.minute !== 0);
}

/** 放送信息：有具体时刻显示「周X HH:mm」，只有日期时只显示星期。 */
function formatAirAt(value: string): string {
  const parts = shanghaiParts(value);
  if (!parts) return '';
  const day = WEEKDAY_LABELS[parts.weekday];
  return hasAirTime(value)
    ? `${day} ${pad2(parts.hour)}:${pad2(parts.minute)}`
    : day;
}

/** 放送时刻（HH:mm）；只有日期时返回空串，由调用方省略这一行。 */
function formatAirClock(value: string): string {
  if (!hasAirTime(value)) return '';
  const parts = shanghaiParts(value);
  if (!parts) return '';
  return `${pad2(parts.hour)}:${pad2(parts.minute)}`;
}

/** 距离下一话还有多久：小时 / 天。 */
function formatCountdown(value: string): string {
  const target = new Date(value).getTime();
  if (Number.isNaN(target)) return '';
  const diffMs = target - Date.now();
  if (diffMs <= 0) return '即将更新';
  const hours = Math.ceil(diffMs / 3600000);
  return hours <= 24
    ? `还有 ${hours} 小时`
    : `还有 ${Math.ceil(diffMs / 86400000)} 天`;
}

/** 摘要文字：压掉换行，超长截断。 */
function brief(text: string, max = 90): string {
  const plain = String(text || '')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > max ? `${plain.slice(0, max)}…` : plain;
}

/** 追番卡进度条：总集数不超过 12 时按真实集数，否则固定 12 格按比例填充。 */
function progressTicks(watched: number, total: number): boolean[] {
  const segments = total > 0 && total <= 12 ? total : 12;
  const filled = total > 0 ? Math.round((watched / total) * segments) : 0;
  return Array.from({ length: segments }, (_, index) => index < filled);
}

/** 本周放送表：只聚合同步数据带 nextAirAt 的在追动画（周一到周日）。 */
const airingSchedule = (() => {
  const today = shanghaiParts(new Date().toISOString());
  const weekOrder = [1, 2, 3, 4, 5, 6, 0];
  const days = weekOrder.map((weekday) => ({
    label: WEEKDAY_LABELS[weekday],
    weekday,
    isToday: today?.weekday === weekday,
    shows: [] as { title: string; time: string }[],
  }));
  const byWeekday = new Map(days.map((day) => [day.weekday, day]));
  for (const show of airingShows) {
    if (!show.nextAirAt) continue;
    const parts = shanghaiParts(show.nextAirAt);
    const day = parts ? byWeekday.get(parts.weekday) : undefined;
    if (!parts || !day) continue;
    day.shows.push({
      title: show.title,
      time: formatAirClock(show.nextAirAt),
    });
  }
  for (const day of days)
    day.shows.sort((a, b) =>
      (a.time || '99:99').localeCompare(b.time || '99:99'),
    );
  return days;
})();

const contactIcons: Record<string, string> = {
  mail: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg>',
  code: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 8-5 4 5 4"/><path d="m15 8 5 4-5 4"/></svg>',
  play: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5z"/></svg>',
  rss: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h.01"/><path d="M5 12a7 7 0 0 1 7 7"/><path d="M5 5a14 14 0 0 1 14 14"/></svg>',
  message:
    '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z"/></svg>',
  star: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 4 2.4 5.2 5.6.7-4.2 3.9 1.2 5.6-5-3-5 3 1.2-5.6L4 9.9l5.6-.7z"/></svg>',
  heart:
    '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 4.6-7 9-7 9z"/></svg>',
  home: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 11 8-6 8 6"/><path d="M6 10v9h12v-9"/></svg>',
  book: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h6a3 3 0 0 1 3 3v11a3 3 0 0 0-3-3H5z"/><path d="M19 5h-5a3 3 0 0 0-3 3v11a3 3 0 0 1 3-3h5z"/></svg>',
  camera:
    '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13"/><path d="m8 7 1.5-3h5L16 7"/><circle cx="12" cy="13" r="3.5"/></svg>',
  music:
    '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/></svg>',
  link: '<svg class="ic-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>',
};

/** 没配 Iconify 图标（或图标取不到）时，按链接地址/标签自动识别内置线稿图标。 */
function contactIcon(link: HomeLink): string {
  const href = (link.href ?? '').toLowerCase();
  const label = (link.label ?? '').toLowerCase();
  if (
    href.startsWith('mailto:') ||
    label.includes('邮件') ||
    label.includes('邮箱')
  ) {
    return contactIcons.mail;
  }
  if (href.includes('github') || label.includes('github'))
    return contactIcons.code;
  if (
    href.includes('bgm.tv') ||
    label.includes('bangumi') ||
    label.includes('番')
  ) {
    return contactIcons.play;
  }
  if (
    href.includes('/rss') ||
    href.includes('/articles') ||
    label.includes('rss')
  ) {
    return contactIcons.rss;
  }
  return contactIcons.link;
}

/** 数据块只存预设，数值在这里用实时统计算出来。 */
function presetValue(preset: HomeStatPreset): string {
  const stats = siteStats;
  switch (preset) {
    case 'latest_update':
      return formatLatest(stats?.lastUpdated);
    case 'posts':
      return String(stats?.posts.published ?? 0);
    case 'moments':
      return String(stats?.moments.total ?? 0);
    case 'gallery':
      return String(stats?.gallery.displayed ?? 0);
    case 'bangumi_watching':
      return String(stats?.bangumi.watching ?? 0);
    case 'bangumi_total':
      return String(stats?.bangumi.total ?? 0);
    case 'words':
      return formatWords(stats?.posts.words ?? 0);
    case 'media':
      return String(stats?.media.total ?? 0);
    case 'categories':
      return String(stats?.categories.posts.length ?? 0);
    default:
      return '—';
  }
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content={Astro.generator}>
<title>{formatPageTitle('首页', site)}</title>
<meta name="description" content={site.description}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title={`${site.name} · RSS`} href="/rss.xml">
<script is:inline>try{var t=localStorage.getItem('myon-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;else if(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.dataset.theme='dark';}catch(e){}</script>
<link rel="stylesheet" href="/css/v2.css">
<link rel="stylesheet" href="/css/markdown-extras.css">
<ThemeTokens themeColor={site.themeColor} metaColor={site.themeColor} />
<link rel="stylesheet" href="/css/pages/home.css">
</head>
<body class="home">
<header class="topbar is-home">
  <a class="brand" href="/" aria-label={`${site.name} 首页`}><b>{site.name.toUpperCase()}</b><span>{site.subtitle} / {new Date().getFullYear()}</span></a>
  <nav class="nav" aria-label="主导航">
    <a href="/articles">文章</a>
    <a href="/moments">动态</a>
    <a href="/gallery">展柜</a>
    <a href="/bangumi">追番</a>
    <a href="/tools">工具</a>
  </nav>
  <div class="page-sticker" id="pageSticker">PAGE 01 / 07</div>
  <div class="topmeta"><span><i class="lamp"></i>营业中</span><a href="/admin">后台</a></div>
</header>

<div class="stage" id="stage">

  <!-- 01 封面 -->
  <section class="panel p1 is-active" data-room="封面" data-no="01" aria-label="第 1 页，封面">
    <div class="inner">
      <div class="copy">
        <div class="kicker reveal" style="--i:0"><span class="sticker">{home.pages[0]}</span><span class="sticker sticker--paper">{`VOL. ${year}`}</span></div>
        <h1 class="reveal" style="--i:1">{home.title}<span class="pinkbox">。</span></h1>
        <p class="lead reveal" style="--i:2">
          {leadLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
        </p>
        <div class="stats reveal" style="--i:3">
          {home.stats.map((stat) => (
            <div class:list={['stat-box', { 'is-pink': stat.accent }]}>
              <span class="k">{stat.label}</span>
              <span class="v">{presetValue(stat.preset)}{stat.unit && <small>{stat.unit}</small>}</span>
            </div>
          ))}
        </div>
        <div class="contacts reveal" style="--i:4">
          {home.links.map((link) => {
            const iconSvg = link.icon ? iconSvgs.get(link.icon) : undefined;
            return (
              <a href={link.href}>
                {iconSvg ? (
                  <span
                    class="contact-ic contact-ic--custom"
                    data-icon={link.icon}
                    set:html={iconSvg}
                    aria-hidden="true"
                  />
                ) : (
                  <span
                    class="contact-ic"
                    set:html={contactIcon(link)}
                    aria-hidden="true"
                  />
                )}
                {link.label}
              </a>
            );
          })}
        </div>
        <div class="actions reveal" style="--i:5">
          <button class="btn btn--pink" type="button" id="startBtn">开始翻页 <span class="ar">↓</span></button>
          <a class="arrow-link" href="/articles">直接看文章 <span class="ar">→</span></a>
        </div>
      </div>
      <div class="frame-wrap reveal" style="--i:2">
        <span class="dots" aria-hidden="true"></span>
        <span class="tape" aria-hidden="true"></span>
        <div class="frame">
          <img src={homeCoverImage} alt="被一盏灯照亮的木制陈列柜">
          <span class="cover-year">MYON {year}</span>
        </div>
        <span class="sticker cover-badge">{home.cover.badge}</span>
        <span class="meta-strip">{home.cover.note}</span>
        <aside class="about-card" aria-label="关于 Myon（README）">
          <div class="ah"><span>README.md · 关于</span></div>
          <div class="about-body" id="aboutBody" set:html={aboutHtml}></div>
        </aside>
      </div>
    </div>
    <span class="chapter" aria-hidden="true">01</span>
  </section>

  <!-- 02 文章 -->
  <section class="panel p2" data-room="文章" data-no="02" aria-label="第 2 页，文章">
    <div class:list={['inner', latestPosts.length === 0 && 'inner--no-side']}>
      <div class="p2-left">
      <div class="head reveal" style="--i:0">
        <div>
          <div class="kicker" style="margin-bottom:12px"><span class="sticker">{home.pages[1]}</span></div>
          <h2>最近写的<span class="hl">。</span></h2>
        </div>
        <span class="sticker sticker--paper">{publishedCount} 篇 / {formatWords(siteStats?.posts.words ?? 0)} 字</span>
      </div>
      <div class="reveal" style="--i:1">
        {latestPosts.length > 0 ? (
          <div class="rows">
            {latestPosts.map((post, index) => (
              <a class="r" href={`/articles/${post.slug}`}>
                <span class="no">{String(Math.max(1, publishedCount - index)).padStart(2, '0')}</span>
                <span>
                  <span class="t">{post.title}</span>
                  {post.excerpt && <span class="d">{post.excerpt}</span>}
                </span>
                <span class="m">{formatDate(post.publishedAt)}<br />{post.readingMinutes} 分钟</span>
              </a>
            ))}
            <a class="arrow-link more" href="/articles" style="margin-top:20px">全部 {publishedCount} 篇 <span class="ar" aria-hidden="true">→</span></a>
          </div>
        ) : (
          <div class="home-empty">
            <p>还没有发布文章。</p>
            <a class="arrow-link" href="/articles">去看全部文章 <span class="ar" aria-hidden="true">→</span></a>
          </div>
        )}
      </div>
      </div>
      {latestPosts.length > 0 && (
        <div class="side">
          <div class="frame reveal" style="--i:2"><img src={homeCoverImage} alt=""><div class="cap"><span>FIGURE A</span><span>1830s</span></div></div>
          <div class="frame two reveal" style="--i:3"><img src={homeCoverImage} alt=""><div class="cap"><span>FIGURE B</span><span>册页</span></div></div>
        </div>
      )}
      <span class="bgtype" aria-hidden="true">ARTICLES</span>
    </div>
  </section>

  <!-- 03 动态：最近 4 条公开动态 -->
  <section class="panel p3" data-room="动态" data-no="03" aria-label="第 3 页，动态">
    <div class="inner">
      <div class="head reveal" style="--i:0">
        <span class="sticker">{home.pages[2]}</span>
        <h2 style="margin-top:12px">最近发生的<span class="hl">。</span></h2>
        <p>写了一半的、刚放下的、还没归档的。都是些小事，但确实发生过。</p>
        <div class="count"><b>{momentsTotal}</b><span class="mono">条 / NOTES</span></div>
        {latestMoments.length > 0 && (
          <a class="arrow-link" href="/moments" style="margin-top:18px">全部动态 <span class="ar">→</span></a>
        )}
      </div>
      {latestMoments.length > 0 ? (
        <div class="grid4">
          {latestMoments.map((moment, index) => (
            <div class:list={['mini-panel', 'reveal', `m${index + 1}`, { 'is-pink': index === 1 }]} style={`--i:${index + 1}`}>
              <div class="pm">
                <span>{formatRelativeTime(moment.createdAt)}</span>
                <span>N°{String(Math.max(1, momentsTotal - index)).padStart(3, '0')}</span>
              </div>
              <p>{brief(moment.body)}</p>
              {moment.mediaKey && (
                <div class="frame">
                  <img src={mediaUrl(moment.mediaKey) ?? ''} alt={`动态配图 · ${moment.category}`} loading="lazy" />
                  <div class="cap"><span>{moment.category}</span><span>P.03</span></div>
                </div>
              )}
              <div class="pf">
                <span>{moment.pinned ? '置顶' : '动态'}</span>
                <span>#{moment.tag || moment.category}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="home-empty">
          <p>还没有发布动态。</p>
          <a class="arrow-link" href="/moments">去看全部动态 <span class="ar" aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- 04 展柜：统计与拼贴都来自 D1 已展示的藏品 -->
  <section class="panel p4" data-room="展柜" data-no="04" aria-label="第 4 页，展柜">
    <div class="inner">
      <div class="head reveal" style="--i:0">
        <div class="kicker"><span class="sticker">{home.pages[3]}</span></div>
        <h2>收藏<span class="hl">。</span></h2>
        <div class="big"><b>{galleryTotal}</b><span class="u">件 / {galleryCategories.length} 类</span></div>
        {galleryCategoryRows.length > 0 && (
          <div class="cat-list">
            {galleryCategoryRows.map((category) => (
              <span>{category.name} <b>{category.count}</b></span>
            ))}
            {galleryOtherCount > 0 && <span>其他 <b>{galleryOtherCount}</b></span>}
          </div>
        )}
        {galleryTotal > 0 && (
          <a class="arrow-link" href="/gallery" style="margin-top:20px">走进展柜 <span class="ar">→</span></a>
        )}
      </div>
      {galleryCards.length > 0 ? (
        <div class:list={['collage', 'reveal', galleryCards.length === 1 && 'collage--one', galleryCards.length === 2 && 'collage--two']} style="--i:1">
          <span class="halo" aria-hidden="true"></span>
          {galleryCards.map((item, index) => (
            <div class:list={['frame', `f${index + 1}`]}>
              <img src={item.image} alt={item.name} loading="lazy" />
              <div class="cap"><span>{item.no} {item.name}</span><span>{item.category}</span></div>
            </div>
          ))}
          <span class="sticker s1" style="background:var(--ink);color:var(--pink)">NEW ARRIVAL</span>
          <span class="sticker s2 sticker--paper">CAT.04</span>
        </div>
      ) : (
        <div class="home-empty">
          <p>{galleryTotal > 0 ? '藏品的图片还在整理。' : '展柜里还没有展出藏品。'}</p>
          <a class="arrow-link" href="/gallery">走进展柜 <span class="ar" aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- 05 追番：动画在追与本周放送都来自 Bangumi 同步到 D1 的数据 -->
  <section class="panel p5" data-room="追番" data-no="05" aria-label="第 5 页，追番">
    <div class="inner">
      <div class="head reveal" style="--i:0">
        <div>
          <div class="kicker" style="margin-bottom:10px"><span class="sticker">{home.pages[4]}</span></div>
          <h2>在追<span class="hl">。</span></h2>
        </div>
        <div class="onair">
          <span class="dot"></span>
          <span>{watchedShows.length > 0 ? `ON AIR · 动画在追 ${animeWatchingCount} 部${bangumiWatchingCount > animeWatchingCount ? ` · 全部在追 ${bangumiWatchingCount}` : ''}` : 'ON AIR · 还没有在追的动画'}</span>
          {watchedShows.length > 0 && (
            <a class="arrow-link" href="/bangumi">全部记录 <span class="ar">→</span></a>
          )}
        </div>
      </div>
      {watchedShows.length > 0 ? (
        <div class="programs reveal" style="--i:1">
          {watchedShows.map((show, index) => (
            <a class="program" href="/bangumi">
              <div class="ptop">
                <span class="pno">{String(index + 1).padStart(2, '0')}</span>
                <span class="ep">{show.totalEps > 0 ? `EP.${show.watchedEps} / ${show.totalEps}` : `EP.${show.watchedEps}`}</span>
              </div>
              <h3>{show.title}</h3>
              <div class="meta">{show.score ? `评分 ${show.score}` : '动画 · 在追'}{show.nextAirAt ? ` · 下回 ${formatAirAt(show.nextAirAt)}` : ' · 更新未定'}</div>
              <div class="prog">
                {progressTicks(show.watchedEps, show.totalEps).map((on) => (
                  <i class:list={[{ on }]}></i>
                ))}
              </div>
              <div class="next">
                <span>{show.nextAirAt ? `下一话 · ${formatAirAt(show.nextAirAt)}` : '进度'}</span>
                <span>{show.nextAirAt && hasAirTime(show.nextAirAt) ? formatCountdown(show.nextAirAt) : `${show.watchedEps} / ${show.totalEps}`}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="home-empty">
          <p>还没有在追的动画。</p>
          <a class="arrow-link" href="/bangumi">全部记录 <span class="ar" aria-hidden="true">→</span></a>
        </div>
      )}
      {airingShows.length > 0 && (
        <div class="schedule reveal" style="--i:2" aria-label="本周更新">
          {airingSchedule.map((day) => (
            <div class:list={['d', { 'is-today': day.isToday }]}>
              <b>{day.label}</b>
              {day.shows.length > 0 ? (
                <span>
                  {day.shows.slice(0, 2).map((show, index) => (
                    <Fragment>{index > 0 && <br />}{show.title}{show.time && <br />}{show.time}</Fragment>
                  ))}
                  {day.shows.length > 2 && <Fragment><br />等 {day.shows.length - 2} 部</Fragment>}
                </span>
              ) : (
                <span>—</span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 06 工具：抽屉列表来自 D1，不再有调用次数 -->
  <section class="panel p6" data-room="工具" data-no="06" aria-label="第 6 页，工具">
    <div class="inner">
      <div class="head reveal" style="--i:0">
        <div class="kicker"><span class="sticker">{home.pages[5]}</span></div>
        <h2>工具箱<span class="hl">。</span></h2>
        <p>{homeTools.length > 0 ? `${homeTools.length} 个自己会用的东西，顺手放在部室的抽屉里。` : '抽屉还空着，等登记了工具再打开。'}</p>
        <div class="open"><b>{String(homeTools.length).padStart(2, '0')}</b><span>个 / TOOLS</span></div>
        {homeTools.length > 0 && (
          <a class="arrow-link" href="/tools" style="margin-top:12px">打开工具台 <span class="ar">→</span></a>
        )}
      </div>
      <div class="reveal" style="--i:1">
        {homeTools.length > 0 ? (
          <div class="drawers">
            {homeTools.slice(0, 8).map((tool, index) => (
              <a class="drawer" href={`/tools/${tool.slug}`}>
                <span class="dno">{String(index + 1).padStart(2, '0')}</span>
                <span class="dn">{tool.name}</span>
                <span class="dd"><span>{tool.description || tool.kind || '打开工具'}</span><span>→</span></span>
              </a>
            ))}
            <a class="drawer drawer--more" href="/tools"><span class="dno">→</span><span class="dn">打开工具台</span><span class="dd"><span>ALL TOOLS</span><span>↗</span></span></a>
          </div>
        ) : (
          <div class="home-empty">
            <p>还没有登记工具。</p>
            <a class="arrow-link" href="/tools">打开工具台 <span class="ar" aria-hidden="true">→</span></a>
          </div>
        )}
        <div class="note"><span>{homeTools.length} 个工具 · 页面由 Workers 送达</span><span>换算在浏览器完成 · 不写入 D1</span></div>
      </div>
    </div>
  </section>

  <!-- 07 尾页 -->
  <section class="panel p7" data-room="尾页" data-no="07" aria-label="第 7 页，后记">
    <div class="inner">
      <div class="copy reveal" style="--i:0">
        <div class="label"><span class="sticker">{home.pages[6]}</span><span class="sticker sticker--paper">FIN</span></div>
        <h2>{end.title}<span class="hl">。</span></h2>
        <p class="after">{end.lead}</p>
        <div class="thank"><span class="t">{author.toUpperCase()}</span><span class="s">{site.subtitle} · © {year} {author}</span></div>
      </div>
      <div class="letter reveal" style="--i:2">
        <div class="lt"><span>AFTERWORD / 后记</span><span>P.07</span></div>
        <p>
          {afterwordLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
        </p>
        {end.afterword.sign && <div class="sign">{end.afterword.sign}</div>}
        {end.afterword.next && <span class="nextissue">{end.afterword.next}</span>}
      </div>
    </div>
  </section>
</div>

<div class="sheet" aria-hidden="true"><span class="pg" id="sheetPg">01</span></div>

<div class="scroll-cue" id="scrollCue" aria-hidden="true">本页还有内容 · 滚到底翻页 ↓</div>

<SiteBar settings={site}>
  <Fragment slot="left">
    <div class="pager" aria-label="翻页">
      <button data-go="0" aria-current="true">01</button>
      <button data-go="1">02</button>
      <button data-go="2">03</button>
      <button data-go="3">04</button>
      <button data-go="4">05</button>
      <button data-go="5">06</button>
      <button data-go="6">07</button>
    </div>
    <span class="hint"><span id="hintText">滚动 · 翻到下一页</span><span class="ln"></span></span>
  </Fragment>
</SiteBar>

<script is:inline>
(function(){
  var stage = document.getElementById('stage');
  var panels = Array.prototype.slice.call(document.querySelectorAll('.panel'));
  var pager = Array.prototype.slice.call(document.querySelectorAll('.pager button'));
  var pageSticker = document.getElementById('pageSticker');
  var sheetPg = document.getElementById('sheetPg');
  var hintText = document.getElementById('hintText');
  var cue = document.getElementById('scrollCue');
  var idx = 0, lock = false, wheelAcc = 0, wheelTimer = null;

  function paint(){
    panels.forEach(function(p, i){
      p.classList.toggle('is-active', i === idx);
      p.classList.toggle('is-above', i < idx);
      p.classList.toggle('is-below', i > idx);
      p.setAttribute('aria-hidden', i === idx ? 'false' : 'true');
      if(i === idx){ p.removeAttribute('inert'); } else { p.setAttribute('inert',''); }
    });
    pager.forEach(function(b, i){ b.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
    var no = ('0' + (idx + 1)).slice(-2);
    pageSticker.textContent = 'PAGE ' + no + ' / 07';
    if(sheetPg) sheetPg.textContent = no;
    if(hintText) hintText.textContent = hintFor();
    try { sessionStorage.setItem('myon-v2-panel', String(idx)); } catch(e){}
    if(location.hash !== '#p=' + idx){ try { history.replaceState(null, '', '#p=' + idx); } catch(e){} }
    updateCue();
  }

  function readPanel(){
    var m = /(?:^|[#&?])p=(\d+)/.exec(location.hash + '&' + location.search);
    if(m){ var n = parseInt(m[1], 10); if(!isNaN(n)) return Math.max(0, Math.min(panels.length - 1, n)); }
    try { var st = parseInt(sessionStorage.getItem('myon-v2-panel') || '', 10); if(!isNaN(st)) return Math.max(0, Math.min(panels.length - 1, st)); } catch(e){}
    return 0;
  }

  function activePanel(){ return panels[idx]; }
  function canScroll(p){ return !!p && p.scrollHeight - p.clientHeight > 8; }
  function atTop(p){ return !p || p.scrollTop <= 2; }
  function atBottom(p){ return !p || p.scrollTop + p.clientHeight >= p.scrollHeight - 2; }
  function hintFor(){
    var p = activePanel();
    if(canScroll(p) && !atBottom(p)) return '本页还有内容 · 滚到底翻页';
    return idx === panels.length - 1 ? '滚动 · 回到第一页' : '滚动 · 翻到下一页';
  }
  function updateCue(){
    var p = activePanel();
    var show = canScroll(p) && !atBottom(p);
    if(cue) cue.classList.toggle('is-on', show);
    if(hintText) hintText.textContent = hintFor();
  }
  function scrollPanelBy(p, dir){
    var step = Math.max(120, Math.round(p.clientHeight * 0.72));
    p.scrollBy({ top: dir * step, behavior: 'smooth' });
  }

  function bump(){
    stage.classList.remove('bump');
    void stage.offsetWidth;
    stage.classList.add('bump');
    setTimeout(function(){ stage.classList.remove('bump'); }, 320);
  }

  function go(n){
    if(lock) return;
    if(n < 0){ bump(); return; }
    if(n > panels.length - 1){ bump(); return; }
    if(n === idx) return;
    lock = true;
    idx = n;
    if(panels[idx]) panels[idx].scrollTop = 0;
    paint();
    // 淡入淡出：旧页在 .42s 内淡出，新页同时淡入，不再叠加主题色闪光
    setTimeout(function(){ lock = false; }, 460);
  }

  pager.forEach(function(b){ b.addEventListener('click', function(){ go(parseInt(b.getAttribute('data-go'), 10)); }); });

  window.addEventListener('wheel', function(e){
    var p = activePanel();
    var delta = e.deltaY;
    if(delta === 0) return;

    // 本页内容比一屏高时：先让面板自己滚，滚到底/顶再翻页
    if(canScroll(p)){
      var blocked = delta > 0 ? atBottom(p) : atTop(p);
      if(!blocked){ updateCue(); return; }
    }

    e.preventDefault();
    wheelAcc += delta;
    clearTimeout(wheelTimer);
    wheelTimer = setTimeout(function(){ wheelAcc = 0; }, 180);
    if(Math.abs(wheelAcc) < 24) return;
    var dir = wheelAcc > 0 ? 1 : -1;
    wheelAcc = 0;
    go(idx + dir);
  }, { passive: false });

  window.addEventListener('keydown', function(e){
    var down = e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ';
    var up = e.key === 'ArrowUp' || e.key === 'PageUp';
    if(down || up){
      e.preventDefault();
      var dir = down ? 1 : -1;
      var p = activePanel();
      if(canScroll(p)){
        var blocked = dir > 0 ? atBottom(p) : atTop(p);
        if(!blocked){ scrollPanelBy(p, dir); return; }
      }
      go(idx + dir);
      return;
    }
    if(e.key === 'Home'){ e.preventDefault(); go(0); }
    else if(e.key === 'End'){ e.preventDefault(); go(panels.length - 1); }
  });

  var touchY = null;
  window.addEventListener('touchstart', function(e){ touchY = e.touches[0].clientY; }, { passive: true });
  window.addEventListener('touchend', function(e){
    if(touchY === null) return;
    var p = activePanel();
    var dy = touchY - e.changedTouches[0].clientY;
    touchY = null;
    if(Math.abs(dy) <= 46) return;

    var dir = dy > 0 ? 1 : -1;
    if(canScroll(p)){
      var blocked = dir > 0 ? atBottom(p) : atTop(p);
      if(!blocked) return;
    }
    go(idx + dir);
  }, { passive: true });

  panels.forEach(function(p){ p.addEventListener('scroll', updateCue, { passive: true }); });
  window.addEventListener('resize', updateCue);

  document.getElementById('startBtn').addEventListener('click', function(){ go(1); });

  idx = readPanel();
  paint();
  if(idx > 0) try { history.replaceState(null, '', '#p=' + idx); } catch(e){}

  window.addEventListener('pageshow', function(e){
    if(e.persisted){ var n = readPanel(); if(n !== idx){ idx = n; paint(); } }
  });
  window.addEventListener('hashchange', function(){ var n = readPanel(); if(n !== idx){ idx = n; paint(); } });
})();
</script>
<script is:inline src="/js/site.js" defer></script>
</body>
</html>
