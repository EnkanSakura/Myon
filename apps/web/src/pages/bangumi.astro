---
/**
 * 追番页：可切换 总览 / 动画 / 书籍 / 音乐 / 游戏 / 三次元。
 * 数据来自 D1（/api/v1/bangumi?type=…&sort=recent），统计来自 /api/v1/stats。
 * 样式：public/css/pages/bangumi.css。
 */
import { env } from 'cloudflare:workers';
import app from '@myon/back';
import type { AppBindings } from '@myon/back/types';
import {
  apiBasePath,
  type BangumiShow,
  type BangumiStatus,
  type BangumiSubjectType,
  bangumiSubjectTypeLabels,
  bangumiSubjectTypes,
  type Paginated,
  type SiteStats,
} from '@myon/shared';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate } from '../lib/format';
import { mediaUrl } from '../lib/media';

const TZ = 'Asia/Shanghai';
const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const STATUS_LABEL: Record<BangumiStatus, string> = {
  watching: '进行中',
  watched: '已完成',
  wish: '想看',
  paused: '暂缓',
};
const TYPE_STATUS: Record<BangumiSubjectType, string> = {
  anime: '在追',
  book: '在读',
  music: '在听',
  game: '在玩',
  real: '在看',
};
const PAGE_SIZE = 24;

interface DateParts {
  year: number;
  month: number;
  day: number;
  hour: number;
  minute: number;
}

interface DayCell {
  key: string;
  label: string;
  weekday: string;
  isToday: boolean;
  shows: { time: string; title: string }[];
}

const SHANGHAI_TIME = new Intl.DateTimeFormat('en-CA', {
  timeZone: TZ,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
});

const pad2 = (value: number) => String(value).padStart(2, '0');

function readDateParts(date: Date): DateParts {
  const values: Record<string, number> = {};
  for (const part of SHANGHAI_TIME.formatToParts(date)) {
    if (part.type !== 'literal') values[part.type] = Number(part.value);
  }
  return {
    year: values.year ?? 1970,
    month: values.month ?? 1,
    day: values.day ?? 1,
    hour: values.hour ?? 0,
    minute: values.minute ?? 0,
  };
}

function shanghaiParts(value: string | null | undefined): DateParts | null {
  if (!value) return null;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : readDateParts(date);
}

function dateKey(parts: DateParts): string {
  return `${parts.year}-${pad2(parts.month)}-${pad2(parts.day)}`;
}

function weekdayOf(parts: DateParts): number {
  return new Date(Date.UTC(parts.year, parts.month - 1, parts.day)).getUTCDay();
}

function daysBetween(from: DateParts, to: DateParts): number {
  return Math.round(
    (Date.UTC(to.year, to.month - 1, to.day) -
      Date.UTC(from.year, from.month - 1, from.day)) /
      86_400_000,
  );
}

function isoWeekNumber(parts: DateParts): number {
  const thursday = new Date(Date.UTC(parts.year, parts.month - 1, parts.day));
  thursday.setUTCDate(
    thursday.getUTCDate() - ((thursday.getUTCDay() + 6) % 7) + 3,
  );
  const firstThursday = new Date(Date.UTC(thursday.getUTCFullYear(), 0, 4));
  firstThursday.setUTCDate(
    firstThursday.getUTCDate() - ((firstThursday.getUTCDay() + 6) % 7) + 3,
  );
  return (
    1 + Math.round((thursday.getTime() - firstThursday.getTime()) / 604_800_000)
  );
}

function scoreLabel(score: number | null): string {
  return typeof score === 'number' && Number.isFinite(score)
    ? score.toFixed(1)
    : '—';
}

/** 各类型的进度单位不同：书籍按卷、音乐按曲、游戏按百分比、其余按集。 */
function progressOf(show: BangumiShow) {
  const total = Math.max(0, show.totalEps);
  const watchedRaw = Math.max(0, show.watchedEps);
  const watched = total > 0 ? Math.min(watchedRaw, total) : watchedRaw;
  const percent =
    total > 0 ? Math.min(100, Math.round((watched / total) * 100)) : null;
  const label =
    show.subjectType === 'book'
      ? total > 0
        ? `第 ${watched} 卷 / 共 ${total} 卷`
        : `已读 ${watched} 卷`
      : show.subjectType === 'music'
        ? total > 0
          ? `第 ${watched} 曲 / 共 ${total} 曲`
          : `已听 ${watched} 曲`
        : show.subjectType === 'game'
          ? percent === null
            ? '进度待定'
            : `进度 ${percent}%`
          : total > 0
            ? `${watched} / ${total} 集`
            : `已看 ${watched} 集`;
  return {
    total,
    watched,
    percent,
    label,
    short: total > 0 ? `${watched}/${total}` : `${watched}`,
    meta: `${TYPE_STATUS[show.subjectType] ?? '进行中'} · ${label} · 评分 ${scoreLabel(show.score)}`,
  };
}

function nextAirFor(show: BangumiShow, today: DateParts) {
  const air = shanghaiParts(show.nextAirAt);
  const progress = progressOf(show);
  if (!air) return { left: '下一话 · 待定', right: progress.short };
  const diff = daysBetween(today, air);
  const time = `${pad2(air.hour)}:${pad2(air.minute)}`;
  return {
    left: `下一话 · ${WEEKDAYS[weekdayOf(air)]} ${time}`,
    right:
      diff < 0
        ? '已放送 · 待更新'
        : diff === 0
          ? '今天'
          : diff === 1
            ? '明天'
            : `还有 ${diff} 天`,
  };
}

const binding = env as unknown as AppBindings;
const rawPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page =
  Number.isFinite(rawPage) && rawPage >= 1 ? Math.min(rawPage, 10000) : 1;
const offset = (page - 1) * PAGE_SIZE;

const typeParam = Astro.url.searchParams.get('type');
const activeType = (bangumiSubjectTypes as readonly string[]).includes(
  typeParam ?? '',
)
  ? (typeParam as BangumiSubjectType)
  : null;
const isOverview = activeType === null;

async function readStats(): Promise<SiteStats | null> {
  try {
    const res = await app.request('/api/v1/stats', {}, binding);
    return res.ok ? ((await res.json()) as SiteStats) : null;
  } catch (error) {
    console.error('[bangumi] 读取站点统计失败', error);
    return null;
  }
}

async function readPage(
  query: string,
): Promise<{ items: BangumiShow[]; total: number }> {
  try {
    const res = await app.request(`/api/v1/bangumi${query}`, {}, binding);
    if (res.status !== 200) {
      console.error(`[bangumi] /api/v1/bangumi${query} 返回 ${res.status}`);
      return { items: [], total: 0 };
    }
    const data = (await res.json()) as Paginated<BangumiShow>;
    const list = Array.isArray(data.items) ? data.items : [];
    return {
      items: list,
      total: typeof data.total === 'number' ? data.total : list.length,
    };
  } catch (error) {
    console.error('[bangumi] 读取追番数据失败', error);
    return { items: [], total: 0 };
  }
}

const stats = await readStats();
const overviewRecent = isOverview
  ? await readPage('?sort=recent&limit=8')
  : { items: [], total: 0 };
const categoryPage = isOverview
  ? { items: [], total: 0 }
  : await readPage(`?type=${activeType}&limit=${PAGE_SIZE}&offset=${offset}`);
const animeSchedule =
  activeType === 'anime'
    ? await readPage('?type=anime&limit=100&sort=recent')
    : { items: [], total: 0 };

const byType = stats?.bangumi.byType;
const byStatus = stats?.bangumi.byStatus;
const total = stats?.bangumi.total ?? 0;
const watchingTotal = stats?.bangumi.watching ?? 0;
const categoryTotal = activeType
  ? (byType?.[activeType].total ?? categoryPage.total)
  : total;
const categoryWatching = activeType
  ? (byType?.[activeType].watching ?? 0)
  : watchingTotal;
const itemTotal = activeType ? categoryPage.total : overviewRecent.total;
const items = activeType ? categoryPage.items : overviewRecent.items;
const totalPages = Math.max(1, Math.ceil(itemTotal / PAGE_SIZE));
const hasNext = activeType ? offset + items.length < itemTotal : false;
const pageLabel = activeType ? bangumiSubjectTypeLabels[activeType] : '总览';

const today = readDateParts(new Date());
const todayKey = dateKey(today);
const weekNumber = isoWeekNumber(today);
const mondayTime =
  Date.UTC(today.year, today.month - 1, today.day) -
  ((weekdayOf(today) + 6) % 7) * 86_400_000;

const scheduleItems = animeSchedule.items.filter(
  (show) => show.subjectType === 'anime' && show.status === 'watching',
);
const week: DayCell[] = Array.from({ length: 7 }, (_, index) => {
  const day = new Date(mondayTime + index * 86_400_000);
  const parts: DateParts = {
    year: day.getUTCFullYear(),
    month: day.getUTCMonth() + 1,
    day: day.getUTCDate(),
    hour: 0,
    minute: 0,
  };
  const key = dateKey(parts);
  return {
    key,
    label: `${pad2(parts.month)}.${pad2(parts.day)}`,
    weekday: WEEKDAYS[weekdayOf(parts)],
    isToday: key === todayKey,
    shows: [],
  };
});
const weekIndex = new Map(week.map((day, index) => [day.key, index]));
for (const show of scheduleItems) {
  const air = shanghaiParts(show.nextAirAt);
  if (!air) continue;
  const index = weekIndex.get(dateKey(air));
  if (index === undefined) continue;
  week[index].shows.push({
    time: `${pad2(air.hour)}:${pad2(air.minute)}`,
    title: show.title,
  });
}
const weekShowCount = week.reduce((sum, day) => sum + day.shows.length, 0);
const weekRange = `${week[0].label} — ${week[6].label}`;

const typeCounts = bangumiSubjectTypes.map((type) => ({
  type,
  label: bangumiSubjectTypeLabels[type],
  total: byType?.[type].total ?? 0,
  watching: byType?.[type].watching ?? 0,
}));
const statusBuckets = (
  ['watching', 'watched', 'wish', 'paused'] as BangumiStatus[]
)
  .map((status) => ({
    status,
    label: STATUS_LABEL[status],
    count: byStatus?.[status] ?? 0,
  }))
  .filter((bucket) => bucket.count > 0);

/** 封面走站内代理 + 边缘缓存；没有源图时退回已有 R2/手填封面。 */
const coverUrlFor = (show: BangumiShow): string | null => {
  const source = show.coverSource?.trim();
  if (source) {
    return `${apiBasePath}/bangumi/cover?src=${encodeURIComponent(source)}`;
  }
  return mediaUrl(show.coverKey);
};

const records = items.map((show) => ({
  show,
  type: bangumiSubjectTypeLabels[show.subjectType],
  status: STATUS_LABEL[show.status],
  progress: progressOf(show),
  next: nextAirFor(show, today),
  cover: coverUrlFor(show),
  updated: formatDate(show.updatedAt),
  rating: typeof show.score === 'number' ? show.score.toFixed(0) : '未评分',
  comment: show.comment?.trim() ?? '',
}));
const latestUpdatedAt = items.reduce<string | null>((latest, item) => {
  if (!item.updatedAt) return latest;
  if (!latest) return item.updatedAt;
  return item.updatedAt > latest ? item.updatedAt : latest;
}, null);
const latestUpdated = latestUpdatedAt ? formatDate(latestUpdatedAt) : '—';
const links = [
  { type: null, label: '总览', count: total },
  ...typeCounts.map((entry) => ({
    type: entry.type,
    label: entry.label,
    count: entry.total,
  })),
];
---

<SiteLayout title="追番" active="bangumi" sticker="PAGE 05 / 07 · 追番">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/pages/bangumi.css" />
  </Fragment>

  <main class="room">
    <div class="wrap">
      <header class="room-head">
        <div>
          <div class="room-kicker">
            <span class="sticker">CH.05 放送</span>
            <span class="sticker sticker--paper sticker--rot">{today.month} 月号</span>
            <span class="sticker sticker--paper">{pageLabel}</span>
          </div>
          <h1>追番<span class="hl">。</span></h1>
        </div>
        <div class="room-stats">
          <div class="stat-box is-pink">
            <span class="k">{activeType ? '本类 / TYPE' : '总收藏 / TOTAL'}</span>
            <span class="v">{categoryTotal}<small>条</small></span>
          </div>
          <div class="stat-box">
            <span class="k">进行中 / DOING</span>
            <span class="v">{categoryWatching}<small>条</small></span>
          </div>
          <div class="stat-box">
            <span class="k">最近更新 / UPDATED</span>
            <span class="v v--word">{latestUpdated}</span>
          </div>
        </div>
        <span class="chapter" aria-hidden="true">05</span>
      </header>

      <nav class="filterbar" aria-label="按类型筛选">
        <div class="filterbar-tabs">
          {links.map((link) => {
            const href = link.type ? `/bangumi?type=${link.type}` : '/bangumi';
            const current = link.type === activeType;
            return (
              <a
                class="filterbar-tab"
                class:list={{ 'is-on': current }}
                href={href}
                aria-current={current ? 'page' : undefined}
              >
                {link.label} <b>{link.count}</b>
              </a>
            );
          })}
        </div>
        <span class="filterbar-count">
          共 <b>{itemTotal}</b> 条
        </span>
      </nav>

      {isOverview ? (
        <>
          <section class="sec" aria-labelledby="recentTitle">
            <div class="sec-head">
              <div class="sec-title">
                <h2 id="recentTitle">最近更新</h2>
                <span class="sticker">RECENT</span>
              </div>
              <div class="sec-side">
                <span class="mono">跨分类 · 按更新时间</span>
              </div>
            </div>
            {records.length > 0 ? (
              <div class="records">
                {records.map((record) => (
                  <article class="record">
                    <span class="record-cover">
                      {record.cover ? (
                        <img src={record.cover} alt="" loading="lazy" data-cover />
                      ) : (
                        <span class="record-nofig">NO IMAGE</span>
                      )}
                    </span>
                    <span class="record-main">
                      <span class="record-kicker">
                        <span class="sticker">{record.type}</span>
                        <span class="record-status">{record.status}</span>
                        <span class="record-score">我的评分 {record.rating}</span>
                      </span>
                      <b class="record-title">{record.show.title}</b>
                      <span class="record-meta">
                        {record.progress.label} · 更新 {record.updated}
                      </span>
                      {activeType === 'anime' && (
                        <span class="record-next">{record.next.left} · {record.next.right}</span>
                      )}
                      {record.comment && <span class="record-comment">{record.comment}</span>}
                    </span>
                  </article>
                ))}
              </div>
            ) : (
              <div class="records-empty">还没有追番记录。同步 Bangumi 之后会出现在这里。</div>
            )}
          </section>

          <aside class="panel-box archive" aria-labelledby="archiveTitle">
            <span class="panel-tab">STATUS / ARCHIVE</span>
            <div class="archive-in">
              <h2 id="archiveTitle">状态存档</h2>
              <ol class="seasons">
                {statusBuckets.map((bucket) => (
                  <li>
                    <span class="srow">
                      <span class="sname">{bucket.label}</span>
                      <span class="smeta">{bucket.count} 条</span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        </>
      ) : (
        <>
          {records.length > 0 ? (
            <div class="records">
              {records.map((record) => (
                <article class="record">
                  <span class="record-cover">
                    {record.cover ? (
                      <img src={record.cover} alt="" loading="lazy" data-cover />
                    ) : (
                      <span class="record-nofig">NO IMAGE</span>
                    )}
                  </span>
                  <span class="record-main">
                    <span class="record-kicker">
                      <span class="sticker">{record.type}</span>
                      <span class="record-status">{record.status}</span>
                      <span class="record-score">我的评分 {record.rating}</span>
                    </span>
                    <b class="record-title">{record.show.title}</b>
                    <span class="record-meta">
                      {record.progress.label} · 更新 {record.updated}
                    </span>
                    {activeType === 'anime' && (
                      <span class="record-next">{record.next.left} · {record.next.right}</span>
                    )}
                    {record.comment && <span class="record-comment">{record.comment}</span>}
                  </span>
                </article>
              ))}
            </div>
          ) : (
            <div class="records-empty">
              这一栏还没有记录。
              <a class="arrow-link" href="/bangumi">回总览 <span class="ar" aria-hidden="true">→</span></a>
            </div>
          )}

          {activeType === 'anime' && (
            <section class="sec" aria-labelledby="scheduleTitle">
              <div class="sec-head">
                <div class="sec-title">
                  <h2 id="scheduleTitle">本周时刻表</h2>
                  <span class="sticker sticker--paper">{weekRange}</span>
                </div>
                <div class="sec-side">
                  <span class="mono">第 {weekNumber} 周 · 均为 UTC+8</span>
                </div>
              </div>
              <div class="week-grid">
                <div class="schedule" role="table" aria-label="本周放送时刻表">
                  {week.map((day) => (
                    <div class:list={['d', { 'is-today': day.isToday }]} role="row">
                      <div class="dh">
                        <b>{day.weekday}</b>
                        <span>{day.label}</span>
                      </div>
                      {day.shows.length > 0 ? (
                        day.shows.map((show) => (
                          <div class="show">
                            <span class="st">{show.time} · 放送</span>
                            <span class="sn">{show.title}</span>
                          </div>
                        ))
                      ) : (
                        <span class="empty">—</span>
                      )}
                    </div>
                  ))}
                </div>
                <aside class="week-side">
                  <span class="sticker sticker--ink">ON AIR · {scheduleItems.length} 部</span>
                </aside>
              </div>
              <p class="week-foot">
                <span>本周放送 {weekShowCount} 话</span>
                <span>放送时间以 Bangumi 收录为准</span>
              </p>
            </section>
          )}
        </>
      )}

      {!isOverview && itemTotal > 0 && (
        <div class="list-foot">
          <span class="mono">
            第 {page} / {totalPages} 页 · 本页 {items.length} 条 · 共 {itemTotal} 条
          </span>
          <div class="list-links">
            {hasNext && (
              <a class="btn btn--pink" href={`/bangumi?type=${activeType}&page=${page + 1}`}>
                更多记录 <span class="ar" aria-hidden="true">→</span>
              </a>
            )}
            {page > 1 && (
              <a class="arrow-link" href={`/bangumi?type=${activeType}&page=1`}>
                回到第一页 <span class="ar" aria-hidden="true">↑</span>
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </main>
  <script is:inline src="/js/pages/bangumi-cover.js"></script>
</SiteLayout>
